#!/bin/bash
# Stub pactl for the backend tests.
#
# The equalizer sink always exists, so sink_present is true and the fragment/live
# paths are exercised at all. A second, device-like sink and the default sink can
# be set per test: PACTL_DEVICE_SINK adds a line to `list sinks short`,
# PACTL_DEFAULT_SINK changes what `get-default-sink` prints. The routing tests
# use them to put a DSP sink in the seat the equalizer has to chain in front of.
#
# PACTL_LOG records every invocation's arguments one per line, for tests that
# assert on the move/aim calls themselves. PACTL_EQ_AIM makes `list sink-inputs`
# return one canned entry for the EQ's own output stream (id 99) aimed at the
# sink deck PACTL_EQ_AIM_SINK_ID (default 2, the device sink). Unset, `list
# sink-inputs` keeps today's table print, so the EQ output stream has no id and
# the aim reads as unknown -- the no-stream state of a real machine between
# starts. PACTL_APP_STREAM adds an application stream (id 42) playing into the
# equalizer, for the tests that check a restart parks it instead of dropping it.
# PACTL_EQ_RATE and PACTL_EQ_STATE describe the equalizer sink's own format: a
# RUNNING sink reports the rate the graph negotiated, which is what the backend
# reads as the graph rate.
sinks="1	omarchy_equalizer	PipeWire	s16le 2ch ${PACTL_EQ_RATE:-48000}Hz	${PACTL_EQ_STATE:-SUSPENDED}"
# PACTL_NO_EQ_SINK names a file; while it exists the equalizer sink is gone (the
# systemctl stub creates it for a restart that does not come back).
[[ -n ${PACTL_NO_EQ_SINK:-} && -e $PACTL_NO_EQ_SINK ]] && sinks="0	placeholder.unused	PipeWire	s16le 2ch 48000Hz	SUSPENDED"
if [[ -n ${PACTL_DEVICE_SINK:-} ]]; then
  sinks="$sinks
2	$PACTL_DEVICE_SINK	PipeWire	s16le 2ch 48000Hz	SUSPENDED"
fi
if [[ -n ${PACTL_DEVICE_SINK2:-} ]]; then
  sinks="$sinks
3	$PACTL_DEVICE_SINK2	PipeWire	float32le 2ch 48000Hz	SUSPENDED"
fi
[[ -n ${PACTL_LOG:-} ]] && printf '%s\n' "$*" >>"$PACTL_LOG"
case "$1" in
  list)
    if [[ ${2:-} == sink-inputs && -n ${PACTL_APP_STREAMS:-} ]]; then
      # PACTL_APP_STREAMS="id:sink:name:binary,..." lists several app streams
      # (comma-separated, so a name may hold spaces), for the exclusion tests; the
      # EQ's own output stream (id 99) comes along when PACTL_EQ_AIM is set too.
      IFS=',' read -ra entries <<<"$PACTL_APP_STREAMS"
      for entry in "${entries[@]}"; do
        IFS=: read -r sid ssink sname sbin <<<"$entry"
        printf 'Sink Input #%s\n\tSink: %s\n\tProperties:\n\t\tapplication.name = "%s"\n\t\tapplication.process.binary = "%s"\n' \
          "$sid" "$ssink" "$sname" "$sbin"
      done
      if [[ -n ${PACTL_EQ_AIM:-} ]]; then
        printf 'Sink Input #99\n\tSink: %s\n\tProperties:\n\t\tnode.name = "omarchy_equalizer.output"\n' "${PACTL_EQ_AIM_SINK_ID:-2}"
      fi
    elif [[ ${2:-} == sink-inputs && -n ${PACTL_APP_STREAM:-} ]]; then
      printf 'Sink Input #42\n\tSink: 1\n\tProperties:\n\t\tapplication.name = "Chromium"\n'
    elif [[ ${2:-} == sinks && ${3:-} != short ]]; then
      # The long form, for a sink's description ("Stub <name>") and, for the
      # device sink, what the device relief reads: PACTL_DEVICE_MUTE (no),
      # PACTL_DEVICE_VOLUME_DB (0.00), PACTL_DEVICE_BASE (100, in percent) and
      # PACTL_DEVICE_FLAGS (a software volume's flags).
      while IFS=$'\t' read -r sidx sname _; do
        printf 'Sink #%s\n\tState: SUSPENDED\n\tName: %s\n\tDescription: Stub %s\n' "$sidx" "$sname" "$sname"
        if [[ -n ${PACTL_DEVICE_SINK:-} && $sname == "$PACTL_DEVICE_SINK" ]]; then
          # PACTL_DEVICE_VOLUME_FILE, when set, is read instead: a test can move
          # the volume under a running follower.
          dv="${PACTL_DEVICE_VOLUME_DB:-0.00}"
          [[ -n ${PACTL_DEVICE_VOLUME_FILE:-} && -s $PACTL_DEVICE_VOLUME_FILE ]] && dv="$(<"$PACTL_DEVICE_VOLUME_FILE")"
          printf '\tMute: %s\n' "${PACTL_DEVICE_MUTE:-no}"
          printf '\tVolume: front-left: 32768 /  50%% / %s dB,   front-right: 32768 /  50%% / %s dB\n' "$dv" "$dv"
          printf '\t        balance 0.00\n'
          printf '\tBase Volume: 65536 / %s%% / 0.00 dB\n' "${PACTL_DEVICE_BASE:-100}"
          printf '\tFlags: %s\n' "${PACTL_DEVICE_FLAGS:-HARDWARE DECIBEL_VOLUME LATENCY}"
        fi
      done <<<"$sinks"
    elif [[ ${2:-} == sink-inputs && -n ${PACTL_EQ_AIM:-} ]]; then
      { printf 'Sink Input #99\n\tSink: %s\n\tProperties:\n' "${PACTL_EQ_AIM_SINK_ID:-2}"
        printf '\t\tnode.name = "omarchy_equalizer.output"\n'
      }
    else
      printf '%s\n' "$sinks"
    fi
    ;;
  subscribe)
    # PACTL_SUBSCRIBE_COUNT change events on the EQ's stream, spaced wider than
    # the follower's 0.4 s drain so each one is its own pass. PACTL_SUBSCRIBE_EVENT
    # replaces the event's text (a volume change on a sink, say), and
    # PACTL_SUBSCRIBE_GAP the spacing (a held volume key is a closer burst).
    for ((i = 0; i < ${PACTL_SUBSCRIBE_COUNT:-0}; i++)); do
      sleep "${PACTL_SUBSCRIBE_GAP:-0.5}"; printf '%s\n' "${PACTL_SUBSCRIBE_EVENT:-Event 'change' on sink-input #99}"
    done
    ;;
  get-default-sink) printf '%s\n' "${PACTL_DEFAULT_SINK:-omarchy_equalizer}" ;;
  # The equalizer sink's volume; PACTL_SINK_VOLUME_DB sets it (default full).
  get-sink-volume)
    v="${PACTL_SINK_VOLUME_DB:-0.00}"
    printf 'Volume: front-left: 65536 / 100%% / %s dB,   front-right: 65536 / 100%% / %s dB\n        balance 0.00\n' "$v" "$v" ;;
esac
exit 0
