#!/bin/bash
printf "%s\n" "$*" >> "$SYSTEMCTL_LOG"
# SYSTEMCTL_RESTART_FAILS names a file a restart creates: with PACTL_NO_EQ_SINK set
# to the same path, the equalizer sink does not come back after the restart.
if [[ -n ${SYSTEMCTL_RESTART_FAILS:-} && " $* " == *" restart "* ]]; then
  : >"$SYSTEMCTL_RESTART_FAILS"
fi
# SYSTEMCTL_PARKED_SNAPSHOT names a file a restart copies the parked-stream record
# into, so a test can see what was on disk at the moment the restart began.
if [[ -n ${SYSTEMCTL_PARKED_SNAPSHOT:-} && " $* " == *" restart "* ]]; then
  cat "$XDG_STATE_HOME/omarchy-equalizer/parked-streams" >"$SYSTEMCTL_PARKED_SNAPSHOT" 2>/dev/null ||
    printf 'none\n' >"$SYSTEMCTL_PARKED_SNAPSHOT"
fi
exit 0
