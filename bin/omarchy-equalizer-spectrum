#!/usr/bin/env python3
"""Live spectrum and beat track of the equalizer's output, for the panel's meter.

Reads the equalizer sink's monitor with parec and prints one line per frame:

    BEAT V1 V2 ... V24

BEAT is 0 or an onset strength 1..100. V1..V24 are band levels 0..100, low
frequencies first, log-spaced 40 Hz .. 11 kHz. The panel runs this only while
it is open and the equalizer is on.

Levels are decibels, not a raw magnitude: each band is placed on a 48 dB scale
whose top sits a little above a slowly tracked loud level, so ordinary music
lands around the middle and a hit has headroom to rise into. Constant-Q bands
already read pink-ish music as roughly flat; a mild +1 dB per octave tilt only
keeps the top octave from looking dead next to the bass.

Beats are spectral flux on the bass bands: the summed rise in dB since the last
frame, compared against its own recent mean and spread. A short refractory
period stops one kick from firing twice.

The analysis is constant-Q Goertzel over a multirate pyramid: every band gets a
window sized to its own bandwidth, taken from the input decimated just far
enough for that band. Treble bands use a few dozen samples, bass bands a few
hundred at a low rate, which keeps this plain Python (no numpy) cheap.
"""
import array
import math
import signal
import subprocess
import sys

RATE = 24000
HOP = 600                 # 40 frames per second
BANDS = 24
LOW, HIGH = 40.0, 11000.0
LEVELS = 6                # decimation levels: 24k down to 750 Hz
RANGE_DB = 48.0           # dB from the floor to the top of the scale
HEADROOM_DB = 9.0         # top of the scale above the tracked loud level
SINK = sys.argv[1] if len(sys.argv) > 1 else "omarchy_equalizer"

freqs = [LOW * (HIGH / LOW) ** (b / (BANDS - 1)) for b in range(BANDS)]
ratio = (HIGH / LOW) ** (1 / (BANDS - 1))
bands = []
for f in freqs:
    # The coarsest level whose Nyquist still clears the band with margin.
    level = 0
    while level + 1 < LEVELS and f < (RATE >> (level + 1)) / 5:
        level += 1
    rate = RATE >> level
    width = f * (ratio - 1)
    # A Hann main lobe spans about 4 bins; size the window so it spans the band.
    n = int(round(4 * rate / width))
    n = max(32, min(256, n))
    hann = [0.5 - 0.5 * math.cos(2 * math.pi * i / (n - 1)) for i in range(n)]
    gain = sum(hann) / 2          # full-scale sine -> magnitude 1
    tilt = 10 * math.log10(f / 1000) / 3   # +1 dB per octave, 0 dB at 1 kHz
    bands.append((level, n, hann, 2 * math.cos(2 * math.pi * f / rate), gain, tilt))
BASS = [i for i, f in enumerate(freqs) if f < 160]
MAX_N = [max([b[1] for b in bands if b[0] == lv] or [0]) for lv in range(LEVELS)]

proc = subprocess.Popen(
    ["parec", "-d", SINK + ".monitor", "--format=float32le", "--rate=%d" % RATE,
     "--channels=1", "--latency-msec=20"],
    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def stop(*_):
    proc.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

pyr = [array.array("f") for _ in range(LEVELS)]   # newest samples last
carry = [None] * LEVELS                           # odd sample awaiting a pair
pending = b""
acc = array.array("f")         # samples not yet consumed by a hop
ref = -30.0
prev = [None] * BANDS
flux_hist = []
since_beat = 99
out = sys.stdout


def push(level, samples):
    """Append to one pyramid level and feed the pair-averaged copy downward."""
    buf = pyr[level]
    buf.extend(samples)
    keep = MAX_N[level]
    if len(buf) > keep * 2:
        del buf[:len(buf) - keep]
    if level + 1 < LEVELS:
        src = samples if carry[level] is None else [carry[level]] + list(samples)
        half = len(src) // 2
        down = [(src[2 * i] + src[2 * i + 1]) * 0.5 for i in range(half)]
        carry[level] = src[-1] if len(src) % 2 else None
        if down:
            push(level + 1, down)


while True:
    chunk = proc.stdout.read1(HOP * 4)
    if not chunk:
        break
    pending += chunk
    usable = len(pending) - len(pending) % 4
    got = array.array("f")
    got.frombytes(pending[:usable])
    pending = pending[usable:]
    acc.extend(got)
    while len(acc) >= HOP:
        push(0, acc[:HOP])
        del acc[:HOP]

        dbs = []
        for level, n, hann, c, gain, tilt in bands:
            buf = pyr[level]
            if len(buf) < n:
                dbs.append(-120.0)
                continue
            start = len(buf) - n
            s1 = s2 = 0.0
            for i in range(n):
                s1, s2 = buf[start + i] * hann[i] + c * s1 - s2, s1
            p = s1 * s1 + s2 * s2 - c * s1 * s2
            mag = math.sqrt(p) / gain if p > 0 else 0.0
            dbs.append(20 * math.log10(mag + 1e-9) + tilt)

        # Loud reference: rises fast to the frame's loudest band, falls slowly
        # (about 2 dB/s), and never drops below a sane floor for quiet tracks.
        top = max(dbs)
        if top > ref:
            ref += (top - ref) * 0.25
        else:
            ref -= 2.0 / 40
        ref = max(ref, -60.0)
        hi = ref + HEADROOM_DB
        lo = hi - RANGE_DB
        vals = [int(round(100 * min(1.0, max(0.0, (d - lo) / RANGE_DB)))) for d in dbs]

        # Spectral flux on the bass bands.
        flux = 0.0
        for i in BASS:
            if prev[i] is not None and dbs[i] > lo:
                rise = dbs[i] - prev[i]
                if rise > 0:
                    flux += rise
        prev = dbs
        flux_hist.append(flux)
        if len(flux_hist) > 30:
            del flux_hist[0]
        mean = sum(flux_hist) / len(flux_hist)
        sd = math.sqrt(sum((x - mean) ** 2 for x in flux_hist) / len(flux_hist))
        thr = mean + 1.4 * sd + 1.5
        since_beat += 1
        beat = 0
        if flux > thr and since_beat > 4:      # ~125 ms refractory
            beat = int(min(100, 40 + 60 * (flux - thr) / (thr + 1e-6)))
            since_beat = 0

        try:
            out.write("%d %s\n" % (beat, " ".join(map(str, vals))))
            out.flush()
        except BrokenPipeError:
            stop()
