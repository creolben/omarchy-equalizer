#!/bin/bash

# omarchy:summary=System-wide equalizer (10-band graphic + parametric) with presets
# omarchy:group=audio
#
# Backend for the io.github.creolben.equalizer shell plugin. It hosts a PipeWire
# filter-chain equalizer as its own PipeWire client, so it can be switched on and
# off (and reconfigured) without restarting pipewire.service -- a daemon restart
# drops every PulseAudio client connection and apps that do not reconnect have
# to be restarted by hand.
#
# Why a private config name: PipeWire's stock filter-chain.conf merges every
# fragment in filter-chain.conf.d/, so hosting the EQ there would also load any
# unrelated user filter kept in that directory.
#
# Band layout
#   graphic      fixed 10 ISO bands (31 Hz .. 16 kHz), biquads, one per channel
#   parametric   user-defined bands; each carries type, frequency, Q and gain.
#                With lsp-plugins-lv2 installed the whole set runs on one
#                resident 16-slot LSP node, so type and band count are live values
#                too; without it, it is a per-band biquad chain as before.
#
# Parameter names inside a filter-chain node are "<node>:<Control>", so "g3:Gain"
# is band 3's gain and "para:ft_3" is the pool's slot 3 filter type. That is what
# makes live updates possible: values are written into the running graph with
# pw-cli, and only a change to the *shape* of the graph (a mode switch, or a band
# count change on the no-LSP biquad path) needs a restart.
#
# Routing: the EQ is a virtual sink that plays into the physical output. Turning
# it on makes it the default sink and moves existing streams onto it; turning it
# off restores the previous default and moves the streams back, the same dance
# omarchy-audio-tuning does for the speaker tuning.

set -uo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-equalizer"
plugin_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

host_config="$config_home/pipewire/omarchy-equalizer.conf"
fragment_dir="$config_home/pipewire/omarchy-equalizer.conf.d"
fragment="$fragment_dir/90-eq.conf"
unit_name=omarchy-equalizer.service
unit="$config_home/systemd/user/$unit_name"
# Watches for output-device changes while the EQ is on; see cmd_follow.
follow_unit_name=omarchy-equalizer-follow.service
follow_unit="$config_home/systemd/user/$follow_unit_name"
script_path="$(readlink -f "$0")"

sink_name=omarchy_equalizer
state_file="$state_root/state.json"
running_layout_file="$state_root/running-layout"
user_presets="$state_root/presets.json"
builtin_presets="$plugin_dir/presets"

# The output stage is LSP's stereo multiband compressor, loudness leveler and
# limiter, appended after the bands. They are the stereo builds, so both
# channels are detected together: the mono builds duplicated per channel limited
# and compressed each side on its own, and a loud hit on one side pulled the
# stereo image across. The plugin directory is overridable so a test (or an LSP
# installed somewhere else) can point at a different root; lsp_available only
# trusts the TTLs, which is what the filter-chain needs to load the nodes at all.
lsp_dir="${OMARCHY_EQ_LV2_DIR:-/usr/lib/lv2}/lsp-plugins.lv2"
lsp_mb_compressor_uri="http://lsp-plug.in/plugins/lv2/mb_compressor_stereo"
lsp_limiter_uri="http://lsp-plug.in/plugins/lv2/limiter_stereo"
lsp_autogain_uri="http://lsp-plug.in/plugins/lv2/autogain_stereo"
# Both modes run on one 16-slot para equalizer instead of a per-band biquad
# chain: every slot is in the graph from the start, which is what makes a type,
# slope, bypass or band-count change a live values write rather than a rebuild.
lsp_para_uri="http://lsp-plug.in/plugins/lv2/para_equalizer_x16_stereo"
lsp_plugins="para_equalizer_x16_stereo mb_compressor_stereo limiter_stereo autogain_stereo"

# The graph's shape, written into the fragment's header. A live write is only
# possible into a graph of the same layout, so this is what decides between a
# values write and a rebuild -- including the one rebuild an upgrade from a
# fragment without this line needs.
layout_version=3
# The state file's format. A state from before the field reads as version 2;
# keys this version does not know are carried through every edit untouched.
state_version=3

# Graphic equalizer centre frequencies: the ISO octave series, one decimal
# place so the graph file stays readable.
graphic_freqs=(31 62 125 250 500 1000 2000 4000 8000 16000)
graphic_labels=(31 62 125 250 500 1k 2k 4k 8k 16k)

Q_GRAPHIC=1.41        # ~1 octave bandwidth: the standard graphic-EQ spacing
Q_SHELF=0.71          # shelf slope; Q means something else on a shelf

die() { printf '%s\n' "$*" >&2; exit 1; }

# dB -> linear multiplier, for the preamp node's Mult control. LC_ALL=C keeps the
# decimal point a point whatever the user's locale says.
db_to_mult() { LC_ALL=C awk -v db="${1:-0}" 'BEGIN { printf "%.6f", 10 ^ (db / 20) }'; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }
# Values reach jq through --argjson, so a typo used to surface as a jq parse
# error. Reject it here, where the message can say what was wrong.
is_number() { [[ ${1:-} =~ ^-?[0-9]+([.][0-9]+)?$ ]]; }
need_number() { is_number "${1:-}" || die "'${1:-}' is not a number."; }
# A mode names one of the two band sets, so it must be exactly one of them. The
# fragment writes it into the header comment, and a newline in it would end the
# comment and leave the rest of the value to be read as configuration; the state
# and the preset are both places it can come from, so it is checked at each.
need_mode() { case "${1:-}" in graphic | parametric) ;; *) die "Mode must be graphic or parametric, not '${1:-}'." ;; esac; }
# A sink name is written between double quotes in playback.props, and it comes
# from pactl, where any client can register a node -- a Bluetooth or USB device
# names itself. A quote closes the string early; a backslash or a control
# character (newline, carriage return, tab) smuggles raw configuration past it.
# Every real node name uses letters, digits, dots, dashes, underscores, spaces or
# non-ASCII, so only those three are refused.
need_sink_name() {
  local name="${1:-}"
  [[ ! $name =~ [\"\\] && ! $name =~ [[:cntrl:]] ]] ||
    die "Sink name '$name' contains a quote, backslash or control character."
}

need jq

# ---------------------------------------------------------------- state

state_dir_ensure() { mkdir -p "$state_root"; }

# Two band sets: a flat 10-band graphic set, and a parametric set that opens
# with shelf endpoints and peaking mid-bands.
default_state() {
  jq -n --argjson freqs "$(printf '%s\n' "${graphic_freqs[@]}" | jq -sc '.')" --argjson v "$state_version" '
    {
      version: $v,
      enabled: false,
      mode: "graphic",
      preset: "Flat",
      # A whole-chain gain, before the bands. AutoEq profiles need it: their
      # boosts would clip without the matching cut. With headroom auto the value
      # is recomputed from the bands on every change (and relieved by however
      # far the volume is below full); manual freezes it.
      preamp: 0,
      headroom: "auto",
      # The output stage: the boost (a multiband compressor), the leveler and a
      # brickwall limiter. Every node stays in the graph when LSP is installed;
      # these only choose their controls, so switching is a live write.
      limiter: "on",
      boost: "off",
      leveler: "off",
      # Channel handling ahead of the bands: stereo, mono (both ears hear the
      # whole mix) or swap, and a balance from -1 (left) to 1 (right).
      channels: "stereo",
      balance: 0,
      # Apps whose streams play straight to the device instead of through the EQ.
      excludedApps: [],
      # Every output device keeps its own curve (see device_memory_pass); the key
      # is the device -- a Bluetooth device without its profile suffix.
      deviceMemory: "on",
      deviceCurves: {},
      previousDefaultSink: "",
      targetSink: "",
      graphic: [ $freqs[] | { type: "peaking", freq: ., q: 1.41, gain: 0 } ],
      parametric: [
        { type: "lowshelf",  freq: 80,   q: 0.71, gain: 0 },
        { type: "peaking",   freq: 120,  q: 1.0,  gain: 0 },
        { type: "peaking",   freq: 250,  q: 1.0,  gain: 0 },
        { type: "peaking",   freq: 500,  q: 1.0,  gain: 0 },
        { type: "peaking",   freq: 1000, q: 1.0,  gain: 0 },
        { type: "peaking",   freq: 2000, q: 1.0,  gain: 0 },
        { type: "peaking",   freq: 4000, q: 1.0,  gain: 0 },
        { type: "highshelf", freq: 8000, q: 0.71, gain: 0 }
      ]
    }'
}

# The filter slots a band occupies, as jq: a pass filter with a slope of N runs
# as N cascaded stages, everything else as one. Model.js bandSlots is the same
# rule; a bypassed band keeps its slots so switching it back on never overflows.
jq_slots='def slots: if (.type == "highpass" or .type == "lowpass")
             then ((.slope // 1) | if type == "number" then floor else 1 end
                   | if . < 1 then 1 elif . > 4 then 4 else . end)
             else 1 end;'
max_slots=16

# The pool holds 16 filter slots, so a longer parametric set -- a hand-edited
# state, an old user preset, a crafted profile -- is cut to the bands that fit,
# with a line on stderr, never silently: the fragment cannot carry the rest, and
# a later edit would otherwise act on bands the graph does not have.
cap_parametric_state() {
  local state="$1" count keep
  read -r count keep < <(jq -r "$jq_slots"'
    (.parametric // []) as $p
    | (reduce $p[] as $b ({ used: 0, keep: 0, full: false };
        if .full then .
        else ($b | slots) as $s
          | if .used + $s <= '"$max_slots"' then .used += $s | .keep += 1 else .full = true end
        end)) as $r
    | "\($p | length) \($r.keep)"' <<<"$state" 2>/dev/null || printf '0 0\n')
  if [[ $count =~ ^[0-9]+$ && $keep =~ ^[0-9]+$ ]] && ((keep < count)); then
    printf 'The parametric set has %s bands; keeping the first %s (%s filter slots).\n' \
      "$count" "$keep" "$max_slots" >&2
    jq -c --argjson k "$keep" '.parametric = .parametric[0:$k]' <<<"$state"
  else
    printf '%s\n' "$state"
  fi
}

state_read() {
  local state capped
  if [[ -s $state_file ]]; then
    if jq -e . "$state_file" >/dev/null 2>&1; then
      state="$(cat "$state_file")"
      # Persisted, so the note appears once rather than on every command.
      capped="$(cap_parametric_state "$state")"
      [[ $capped == "$state" ]] || state_write "$capped"
      printf '%s\n' "$capped"
      return
    fi
  fi
  default_state
}

# The ranges a band may hold. A number is not enough: a profile (downloaded or
# hand-made) with "Gain 120 dB" or a negative Q is well-formed and still turns the
# chain into an amplifier that auto headroom, floored at -24 dB, cannot undo. The
# panel never leaves these (gain +-12, 20 Hz..20 kHz, Q 0.1..30); the margin is for
# AutoEq profiles, whose cuts go deeper than the panel's sliders.
band_gain_min=-30 band_gain_max=20
band_freq_min=10 band_freq_max=24000
band_q_min=0.05 band_q_max=30
preamp_min=-60 preamp_max=20
band_types="peaking lowshelf highshelf lowpass highpass bandpass notch allpass"

# The first thing wrong with a state, or nothing. Both band sets are checked, not
# only the active one: a mode switch makes the other set active without another
# edit. One jq pass, so it is cheap enough to run on every write.
state_problem() {
  jq -r \
    --argjson gmin "$band_gain_min" --argjson gmax "$band_gain_max" \
    --argjson fmin "$band_freq_min" --argjson fmax "$band_freq_max" \
    --argjson qmin "$band_q_min" --argjson qmax "$band_q_max" \
    --argjson pmin "$preamp_min" --argjson pmax "$preamp_max" \
    --argjson maxslots "$max_slots" \
    --arg types "$band_types" "$jq_slots"'
    def num: if type == "number" then .
             elif type == "string" and test("^-?[0-9]+([.][0-9]+)?$") then tonumber
             else null end;
    def check($what; $v; $lo; $hi; $where):
      ($v | num) as $n
      | if $n == null then "\($what) must be a number, not \($v | tojson)\($where)."
        elif $n < $lo or $n > $hi then "\($what) \($n) is outside \($lo)..\($hi)\($where)."
        else empty end;
    def oneof($what; $v; $allowed):
      if $v == null or (($v | type) == "string" and ($allowed | index($v)) != null) then empty
      else "\($what) must be one of \($allowed | join(", ")), not \($v | tojson)." end;
    if type != "object" then "The state is not a JSON object."
    else
      [ check("Preamp"; .preamp // 0; $pmin; $pmax; ""),
        oneof("Headroom"; .headroom; ["auto", "manual"]),
        oneof("Limiter"; .limiter; ["on", "off"]),
        oneof("Boost"; .boost; ["off", "low", "medium", "high", "night", "voice"]),
        oneof("Leveler"; .leveler; ["off", "on"]),
        oneof("Channels"; .channels; ["stereo", "mono", "swap"]),
        check("Balance"; .balance // 0; -1; 1; ""),
        ( if (.excludedApps // []) | (type == "array" and all(.[]; type == "string" and length <= 128)) then empty
          else "The excluded apps must be a list of names." end ),
        oneof("Device memory"; .deviceMemory; ["on", "off"]),
        ( if (.deviceCurves // {}) | (type == "object" and all(.[]; type == "object")) then empty
          else "The device curves must map device names to curves." end ),
        ( ["graphic", "parametric"][] as $set
          | (.[$set] // []) as $bands
          | if ($bands | type) != "array" then "The \($set) set is not a list."
            else
              ( $bands | to_entries[] | .key as $i | .value as $b
                | " (\($set) set)" as $where
                | if ($b | type) != "object" then "Band \($i) is not an object\($where)."
                  else
                    ( ($b.type // "peaking") as $t
                      | if ($t | type) == "string" and (($types | split(" ")) | index($t)) != null then empty
                        else "Band \($i) type \($t | tojson) is not one of: \($types)\($where)." end ),
                    check("Band \($i) gain"; $b.gain // 0; $gmin; $gmax; $where),
                    check("Band \($i) freq"; $b.freq // 1000; $fmin; $fmax; $where),
                    check("Band \($i) Q"; $b.q // 1.0; $qmin; $qmax; $where),
                    ( if ($b.enabled // true | type) == "boolean" then empty
                      else "Band \($i) enabled must be true or false\($where)." end ),
                    ( ($b.slope // 1) as $s
                      | if ($s | type) == "number" and $s == ($s | floor) and $s >= 1 and $s <= 4 then empty
                        else "Band \($i) slope must be 1, 2, 3 or 4, not \($s | tojson)\($where)." end )
                  end ),
              ( [ $bands[] | select(type == "object") | slots ] | add // 0 ) as $used
              | if $used > $maxslots
                then "The \($set) set needs \($used) filter slots; the equalizer has \($maxslots)."
                else empty end
            end )
      ] | first // empty
    end' <<<"${1:-}" 2>/dev/null || printf 'The state is not valid JSON.\n'
}

need_valid_state() {
  local problem
  [[ -n ${1:-} ]] || die "Refusing an empty state."
  problem="$(state_problem "$1")"
  [[ -z $problem ]] || die "$problem"
}

# Every write is checked first: a jq or awk failure upstream yields an empty
# string, and writing that would wipe the bands and both remembered sinks.
#
# The file carries its format version. Keys this version does not know -- written
# by a newer one, or by hand -- pass through every edit untouched (each edit is a
# jq update of the whole document), and a newer version number is kept rather
# than written back down.
state_write() {
  need_valid_state "${1:-}"
  state_dir_ensure
  jq --argjson v "$state_version" '.version = (if ((.version // 0) | type) == "number" and (.version // 0) > $v then .version else $v end)' \
    >"$state_file.tmp.$$" <<<"$1" && mv "$state_file.tmp.$$" "$state_file"
}

# The bands the equalizer is currently processing.
active_bands() {
  jq --arg mode "$(jq -r '.mode' <<<"$1")" -r '
    if $mode == "parametric" then .parametric else .graphic end' <<<"$1"
}

# Frequency, gain and Q are interpolated unquoted into the fragment on disk and
# into the live pw-cli parameter list, so a non-number in a band is not a value
# but extra configuration: jq -r decodes its escapes, and a JSON string that
# closes the control braces can append nodes -- a context.exec among them -- to
# the graph. Bands reach here from a crafted profile as much as from a hand edit,
# so walk the set and refuse the first field that is not a plain number.
need_numeric_bands() {
  local problem
  # One pass over the set (a jq per field per band made every slider step cost
  # dozens of processes). The text tested is what jq -r would print, exactly as
  # is_number sees it, so the rule is unchanged.
  problem="$(jq -r '
    def bad($i; $what; $v):
      ($v | tostring) as $t
      | if $t | test("^-?[0-9]+([.][0-9]+)?$") then empty
        else "Band \($i) \($what) must be a number, not '"'"'\($t)'"'"'." end;
    [ to_entries[] | .key as $i | .value as $b
      | bad($i; "freq"; $b.freq // 1000), bad($i; "gain"; $b.gain // 0), bad($i; "Q"; $b.q // 1.0) ]
    | first // empty' <<<"$bands" 2>/dev/null)" || die "The band set is not valid JSON."
  [[ -z $problem ]] || die "$problem"
}

# ---------------------------------------------------------------- headroom

# The peak of the active band chain with the preamp at zero, on the same 400-step
# log sweep Model.js draws its response on. This is a port of that file's
# biquadCoefficients/magnitudeDb/peakDb, so the gain the backend actually applies
# and the curve the panel draws cannot disagree; tests/headroom-check.js holds the
# two side by side. The result is rounded away from zero to the preamp's 0.5 dB
# step -- rounding toward zero would leave a sliver of boost, the clip this exists
# to prevent -- and clamped to the slider's -24 dB floor. A cut-only curve needs
# no preamp.
#
# The sweep runs over the bands as the graph runs them: a bypassed band is left
# out and a pass filter with a slope is its cascade of stages (stages_tsv, the
# jq copy of Model.js bandStages).
auto_preamp_db() {
  stages_tsv "$1" | biquad_curve peak 0 "$(graph_rate)"
}

# The level the curve plays at against Flat, with this preamp: the pink/A-weighted
# blend Model.js curveLevelDb computes, on the same 401-point sweep. The A/B
# compare uses it to play Flat at the curve's own loudness.
curve_level_db() {
  stages_tsv "$1" | biquad_curve level "${2:-0}" "$(graph_rate)"
}

# One line per filter stage the graph runs: type, freq, gain, Q. Model.js
# bandStages is the same expansion -- Butterworth stage Qs for a pass filter's
# slope, scaled by the band's own Q -- and tests/run-tests.sh holds the two to
# the same numbers.
stages_tsv() {
  jq -r '.[] | select(type == "object") | select(.enabled != false)
    | (.type // "peaking") as $t
    | (if ($t == "highpass" or $t == "lowpass") then ((.slope // 1) | if type == "number" then floor else 1 end
         | if . < 1 then 1 elif . > 4 then 4 else . end) else 1 end) as $n
    | if $n <= 1 then [ $t, (.freq // 1000), (.gain // 0), (.q // 1.0) ]
      else ((.q // 0.7071067811865476) / 0.7071067811865476) as $scale
        | range(1; $n + 1) as $k
        | [ $t, (.freq // 1000), 0, ($scale / (2 * ((2 * $k - 1) * 3.141592653589793 / (4 * $n) | cos))) ]
      end
    | @tsv' <<<"${1:-[]}"
}

# The response maths over stage lines on stdin. "peak" prints the automatic
# preamp for the curve; "level" prints the curve's loudness against Flat with the
# given preamp added.
biquad_curve() {
  local what="$1" pre="${2:-0}" rate="${3:-48000}"
  LC_ALL=C awk -v fs="$rate" -v what="$what" -v pre="$pre" '
      # |H(e^jw)| in dB for one biquad, from coefficients already divided by a0.
      function magnitude_db(type, fc, q, gain, f,
                            A, w0, alpha, k, k2, b0, b1, b2, a0, a1, a2,
                            w, c1, s1, c2, s2, nr, ni, dr, di, num, den, ratio) {
        if (fc == 0) fc = 1000
        if (fc < 1) fc = 1
        if (fc > fs / 2 - 1) fc = fs / 2 - 1
        if (q == 0) q = 1
        if (q < 0.05) q = 0.05
        A = 10 ^ (gain / 40)
        w0 = 2 * PI * fc / fs
        alpha = sin(w0) / (2 * q)
        k = cos(w0)
        k2 = 2 * sqrt(A) * alpha

        if (type == "lowshelf") {
          b0 = A * ((A + 1) - (A - 1) * k + k2)
          b1 = 2 * A * ((A - 1) - (A + 1) * k)
          b2 = A * ((A + 1) - (A - 1) * k - k2)
          a0 = (A + 1) + (A - 1) * k + k2
          a1 = -2 * ((A - 1) + (A + 1) * k)
          a2 = (A + 1) + (A - 1) * k - k2
        } else if (type == "highshelf") {
          b0 = A * ((A + 1) + (A - 1) * k + k2)
          b1 = -2 * A * ((A - 1) + (A + 1) * k)
          b2 = A * ((A + 1) + (A - 1) * k - k2)
          a0 = (A + 1) - (A - 1) * k + k2
          a1 = 2 * ((A - 1) - (A + 1) * k)
          a2 = (A + 1) - (A - 1) * k - k2
        } else if (type == "lowpass") {
          b0 = (1 - k) / 2; b1 = 1 - k; b2 = (1 - k) / 2
          a0 = 1 + alpha; a1 = -2 * k; a2 = 1 - alpha
        } else if (type == "highpass") {
          b0 = (1 + k) / 2; b1 = -(1 + k); b2 = (1 + k) / 2
          a0 = 1 + alpha; a1 = -2 * k; a2 = 1 - alpha
        } else if (type == "bandpass") {
          b0 = alpha; b1 = 0; b2 = -alpha
          a0 = 1 + alpha; a1 = -2 * k; a2 = 1 - alpha
        } else if (type == "notch") {
          b0 = 1; b1 = -2 * k; b2 = 1
          a0 = 1 + alpha; a1 = -2 * k; a2 = 1 - alpha
        } else if (type == "allpass") {
          b0 = 1 - alpha; b1 = -2 * k; b2 = 1 + alpha
          a0 = 1 + alpha; a1 = -2 * k; a2 = 1 - alpha
        } else {
          b0 = 1 + alpha * A; b1 = -2 * k; b2 = 1 - alpha * A
          a0 = 1 + alpha / A; a1 = -2 * k; a2 = 1 - alpha / A
        }
        b0 /= a0; b1 /= a0; b2 /= a0; a1 /= a0; a2 /= a0

        w = 2 * PI * f / fs
        c1 = cos(w); s1 = sin(w)
        c2 = cos(2 * w); s2 = sin(2 * w)
        nr = b0 + b1 * c1 + b2 * c2
        ni = -(b1 * s1 + b2 * s2)
        dr = 1 + a1 * c1 + a2 * c2
        di = -(a1 * s1 + a2 * s2)
        num = sqrt(nr * nr + ni * ni)
        den = sqrt(dr * dr + di * di)
        if (den < 1e-12) return 0
        ratio = num / den
        if (ratio < 1e-9) ratio = 1e-9
        return 20 * log(ratio) / log(10)
      }

      # A-weighting in dB, 0 dB at 1 kHz (Model.js aWeightDb).
      function a_weight_db(f,    f2, f4, ra) {
        f2 = f * f; f4 = f2 * f2
        ra = 12194 * 12194 * f4 / ((f2 + 20.6 * 20.6) * sqrt((f2 + 107.7 * 107.7) * (f2 + 737.9 * 737.9)) * (f2 + 12194 * 12194))
        return 20 * log(2 * ra) / log(10) + 2
      }

      # n starts at 0 explicitly: an uninitialized awk scalar has the string value
      # "", so types[n] would file the first band under an index the END loop can
      # never reach. -F\t because a type never contains a tab but jq @tsv
      # separates with them.
      BEGIN { n = 0; FS = "\t" }
      NF >= 4 { types[n] = $1; freqs[n] = $2; gains[n] = $3; qs[n] = $4; n++ }
      END {
        PI = atan2(0, -1)
        lo = 20; hi = 20000; steps = 400; max = -1e300
        sum = 0; wn = 0; wd = 0
        for (i = 0; i <= steps; i++) {
          f = lo * (hi / lo) ^ (i / steps)
          total = (what == "level") ? pre + 0 : 0
          for (b = 0; b < n; b++) total += magnitude_db(types[b], freqs[b], qs[b], gains[b], f)
          if (total > max) max = total
          if (what == "level") {
            w = 10 ^ (a_weight_db(f) / 10)
            sum += total; wn += w * 10 ^ (total / 10); wd += w
          }
        }
        if (what == "level") {
          printf "%.2f\n", (sum / (steps + 1) + 10 * log(wn / wd) / log(10)) / 2
          exit
        }
        if (max <= 0.05) {
          result = 0
        } else {
          c = int(max * 2)
          if (c < max * 2) c++
          result = -c / 2
          if (result < -24) result = -24
          if (result > 0) result = 0
        }
        # Unity is the common case, so print it plainly rather than as "0.0".
        if (result == 0) printf "0\n"; else printf "%.1f\n", result
      }
    '
}

# The most gain a hand-set preamp may hold for this band set: exactly the value
# automatic headroom would pick, so the post-preamp peak still lands at 0 dBFS and
# the limiter's -1 dBFS ceiling only ever sees the last dB. Anything above it is
# gain the limiter has to remove on every sample, which is what "loud, flat and
# grainy" sounds like -- and because the limiter hides it, the panel used to give
# no clue at all. A cut-only curve has a ceiling of 0 dB: the preamp is headroom,
# not a volume control, and Magic Boost is the stage that exists to make things
# louder.
preamp_ceiling_db() { auto_preamp_db "${1:-[]}"; }

# Print a line to stderr when a value was clamped, so a hand-run command says what
# it did rather than silently storing something else.
clamp_warn() {
  printf 'Preamp %s dB is above the headroom ceiling for this curve (%s dB); using %s dB.\n' \
    "$1" "$2" "$2" >&2
}

# With headroom auto the preamp is not the user's to set: it is recomputed from
# the bands on every change. Manual keeps the stored value -- that is what a
# hand-tuned profile expects -- but never above the curve's ceiling, so no edit
# (band, mode, preset, import, reset) can leave the chain over its headroom. Every
# command funnels through here, which is what makes that guarantee hold. A state
# written before the field existed reads as auto, the safe default.
#
# Every command that changes the curve passes through here, so this is also where
# an A/B or a solo ends (the curve they were measured against is gone) and where
# the volume relief is brought up to date for the new curve.
apply_headroom() {
  local state="$1" headroom ceiling preamp
  # The headroom maths below reads every band, so a bad value has to stop here,
  # before awk turns it into a silent zero or an empty state.
  need_valid_state "$state"
  state="$(jq -c 'del(.listen)' <<<"$state")"
  headroom="$(jq -r '.headroom // "auto"' <<<"$state")"
  if [[ $headroom == auto ]]; then
    state="$(jq -c --argjson p "$(auto_preamp_db "$(active_bands "$state")")" '.preamp = $p' <<<"$state")"
  else
    ceiling="$(preamp_ceiling_db "$(active_bands "$state")")"
    preamp="$(jq -r '.preamp // 0' <<<"$state")"
    if [[ $(jq -n --argjson p "$preamp" --argjson c "$ceiling" '$p > $c') == true ]]; then
      clamp_warn "$preamp" "$ceiling"
      state="$(jq -c --argjson p "$ceiling" '.preamp = $p' <<<"$state")"
    fi
  fi
  with_relief "$state"
}

# ---------------------------------------------------------------- volume relief
#
# Automatic headroom cuts the whole signal by the curve's biggest boost, so a
# boost cannot clip -- at full volume. Below full volume the volume control is
# already that much quieter than full scale, and the cut only makes the curve
# play quieter than it should: a +6 dB bass curve at half volume lost 6 dB of
# everything else for nothing, which reads as "thin" and "less clear" even though
# nothing clipped. The relief gives the cut back, as far as the volume allows:
#
#   relief = min(cut, -volume)          (both in dB, never negative)
#
# so the loudest point of the curve still lands at full scale at most, and a
# boost plays as a boost at every volume below the point where it would clip.
# It is a separate gain after the dynamics (relief_l/relief_r), not a change to
# the preamp, so the boost and the leveler see the same level at every volume.
# Manual headroom gets none: manual means the preamp stays where it was left.
# The follower keeps it in step when the volume moves.

# The sink volume in dB, from its loudest channel. pactl prints
#   Volume: front-left: 26214 /  40% / -23.88 dB,   front-right: ...
sink_volume_db() {
  pactl get-sink-volume "$sink_name" 2>/dev/null | LC_ALL=C awk '
    { for (i = 2; i <= NF; i++) if ($i == "dB" || $i == "dB,") {
        v = $(i - 1); if (v == "-inf") v = -200
        if (!seen || v + 0 > best) { best = v + 0; seen = 1 } } }
    END { if (seen) printf "%.2f\n", best }'
}

# The relief for a state at a volume (read from the sink when not given). Floored
# to 0.1 dB, never rounded up: giving back more than the volume allows is a clip.
relief_db() {
  local state="$1" vol="${2-}"
  [[ -n $vol ]] || vol="$(sink_volume_db)"
  jq -r --arg v "${vol:-0}" '
    if (.headroom // "auto") == "manual" then 0
    else ((.preamp // 0) | if . < 0 then -. else 0 end) as $cut
      | ($v | tonumber? // 0) as $vol
      | ([$cut, ([0, -$vol] | max)] | min) | (. * 10 | floor) / 10
    end' <<<"$state"
}

with_relief() {
  local state="$1"
  jq -c --argjson r "$(relief_db "$state")" '.relief = $r' <<<"$state"
}

# ---------------------------------------------------------------- presets

presets_ensure() { state_dir_ensure; [[ -s $user_presets ]] || printf '{}\n' >"$user_presets"; }

preset_is_builtin() { [[ -f $builtin_presets/$1.json ]]; }

preset_read() {
  local name="$1"
  if preset_is_builtin "$name"; then cat "$builtin_presets/$name.json"; return 0; fi
  presets_ensure
  jq -e --arg n "$name" 'has($n)' "$user_presets" >/dev/null 2>&1 || return 1
  jq --arg n "$name" '.[$n]' "$user_presets"
}

preset_list_json() {
  local files=() builtin_json='[]'
  if [[ -d $builtin_presets ]]; then
    for f in "$builtin_presets"/*.json; do
      [[ -e $f ]] || continue
      files+=("$f")
    done
  fi
  if ((${#files[@]})); then
    # One jq for every built-in file, not one per file: the panel polls status
    # while it is open, and a process per preset on every poll is a process storm.
    # A built-in names itself in its own file, which is also what makes the list
    # independent of how the file happens to be called.
    builtin_json="$(jq -c -s '
      map({ name: (.name // ""), description: (.description // null), order: (.order // 999),
            category: (.category // "other") })
      | map(select(.name != ""))' "${files[@]}")"
  fi
  presets_ensure
  # Built-ins first, in the order their files declare (Flat, tone, genre, speech,
  # situation), then the user's own presets alphabetically. A user preset with a
  # built-in's name never reaches here: save-preset refuses the collision.
  jq -c -n --argjson b "$builtin_json" --argjson u "$(cat "$user_presets")" '
    ($b | sort_by(.order, .name) | map(. + { builtin: true }))
    + ($u | keys | sort | map({ name: ., builtin: false,
                                description: ($u[.].description // null), order: 999,
                                category: "user" }))
  '
}

# ---------------------------------------------------------------- graph
#
# Layout (version 3), the same for both band paths:
#
#   pre_l/pre_r     preamp (the headroom cut), before everything
#   mix_l/mix_r     channel handling: stereo, mono or swap, and the balance
#   bands           the 16-slot LSP pool (para), or builtin biquads g<k>_l/g<k>_r
#   level           the loudness leveler            } LSP only, stereo builds,
#   boost           the multiband compressor        } detected on both channels
#   relief_l/_r     the headroom the volume gives back (see volume relief)
#   vol_l/vol_r     the sink volume, driven by capture.volumes
#   limit           the brickwall limiter           } LSP only, stereo-linked
#
# The volume sits after the dynamics and before the limiter: the leveler and the
# compressor always see the program at its own level (a leveler in front of the
# volume would undo every volume change), and the limiter only works when what
# actually leaves the graph would clip. The graph is stereo with explicit inputs
# and outputs, because channel handling needs both channels in one place.

filter_label() {
  case "$1" in
    lowshelf) printf 'bq_lowshelf' ;;
    highshelf) printf 'bq_highshelf' ;;
    lowpass) printf 'bq_lowpass' ;;
    highpass) printf 'bq_highpass' ;;
    bandpass) printf 'bq_bandpass' ;;
    notch) printf 'bq_notch' ;;
    allpass) printf 'bq_allpass' ;;
    *) printf 'bq_peaking' ;;
  esac
}

# ---------------------------------------------------------------- output stage

# The stage, and the band pool, exist only when every LSP plugin the graph names
# is installed. When one is missing, write_fragment emits the builtin biquads and
# no stage nodes, so an LSP-less machine still gets a working equalizer.
lsp_available() {
  local p
  for p in $lsp_plugins; do
    [[ -f $lsp_dir/$p.ttl ]] || return 1
  done
}

# The boost is a three-band compressor into the limiter: a single-band one at
# +10 dB makeup ducks the whole spectrum every time bass hits; separate bass,
# mid and treble detection stops the mids and treble from pumping. Low, medium
# and high are music at three strengths; night and voice are characters:
#
#   night   film and TV at a low volume -- low thresholds, high ratios and a slow
#           release lift quiet dialogue and hold explosions down, so the volume
#           can stay where the dialogue is clear
#   voice   speech, podcasts, calls -- the mid band levels the voice, the bass
#           band barely works so rumble cannot pump it
#
# These "symbol value" lines are the single source for the control block in the
# loaded fragment and the params written live, so the two can never disagree.
# al/kn/mk are the compressor's dB controls and go through db_to_mult like every
# other dB value; off keeps medium's settings so switching it back on is instant
# and level. The bass band's slower attack and release keep the gain from
# moving inside one low-frequency cycle (measured: 0.39 % THD at 30 Hz with the
# mid band's 8 ms, 0.22 % at 30 ms).
#
# The graph always carries all eight bands. Bands 3..7 stay disabled but mirror
# the treble band's controls, so enabling one later cannot read a stale value.
# ofe/ife turn off the FFT analysis displays, which the graph would otherwise pay
# to compute on every quantum.
boost_values() {
  local level="${1:-off}" enabled
  local -a al cr at rt mk
  # The split is bass 0..200 Hz, mid 200..4000 Hz, treble 4000..20000 Hz.
  local -a fre=(200 4000 20000 20000 20000 20000 20000 20000)
  local i bi ce
  case "$level" in
    off)    enabled=0; al=(-24 -22 -22); cr=(3 3 3); at=(30 8 8);   rt=(250 120 120); mk=(7 7 7) ;;
    low)    enabled=1; al=(-20 -18 -18); cr=(2 2 2); at=(30 10 10); rt=(250 150 150); mk=(4 4 4) ;;
    high)   enabled=1; al=(-28 -26 -26); cr=(4 4 4); at=(30 5 5);   rt=(250 100 100); mk=(10 10 10) ;;
    night)  enabled=1; al=(-36 -34 -32); cr=(4 6 5); at=(40 10 10); rt=(400 300 300); mk=(10 14 12) ;;
    voice)  enabled=1; al=(-26 -30 -28); cr=(2 4 3); at=(30 5 5);   rt=(250 150 150); mk=(6 9 8) ;;
    medium | *) enabled=1; al=(-24 -22 -22); cr=(3 3 3); at=(30 8 8); rt=(250 120 120); mk=(7 7 7) ;;
  esac
  # LSP defaults envb ("Envelope boost") to 1 (Pink BT), a pink-noise weighting
  # of the level detector that makes the compressor engage ~17 dB below the
  # configured thresholds. Writing 0 (None) makes al_N mean the documented dB
  # threshold, so the transfer curve matches the table above. ssplit 0 keeps the
  # two channels in one detector; scs_N 5 (Max) drives it from whichever channel
  # is louder, so a hard-panned hit cannot push one side past the other.
  printf 'enabled %s\nmode 1\nofe 0\nife 0\ng_in 1\ng_out 1\ndrywet 100\nenvb 0\nssplit 0\n' "$enabled"
  # cbe_N ("Compression band enable N+1") is the toggle that actually splits the
  # extra bands; the plugin's defaults alternate 0/1 across cbe_1..cbe_7, so
  # without writing them the mid band folds into the bass band and the stage
  # compresses ~10 Hz..4 kHz as one wide band. Band 1 always exists; the split
  # needs cbe_1 and cbe_2 on, the rest off.
  printf 'cbe_1 1\ncbe_2 1\ncbe_3 0\ncbe_4 0\ncbe_5 0\ncbe_6 0\ncbe_7 0\n'
  for ((i = 0; i < 8; i++)); do
    if ((i < 3)); then bi=$i; ce=1; else bi=2; ce=0; fi
    printf 'ce_%d %s\nkn_%d %s\nal_%d %s\ncr_%d %s\nat_%d %s\nrt_%d %s\nmk_%d %s\nscs_%d 5\n' \
      "$i" "$ce" "$i" "$(db_to_mult -6)" "$i" "$(db_to_mult "${al[$bi]}")" \
      "$i" "${cr[$bi]}" "$i" "${at[$bi]}" "$i" "${rt[$bi]}" "$i" "$(db_to_mult "${mk[$bi]}")" "$i"
  done
  # The crossover ladder: sf_N is "Split frequency N+1", the INPUT that ends band N.
  # fre_N ("Frequency range end N") is an OUTPUT -- a value the plugin reports, not one
  # it accepts -- so writing it did nothing except log eight "control can not be set"
  # warnings at every start while the plugin kept its own default ladder, which put the
  # three enabled compressors on 0..40, 40..100 and 100..252 Hz. The splits above the
  # treble band sit at the top of the plugin's range, so those bands -- whose compressors
  # are off -- have no width to act on.
  for ((i = 0; i < 7; i++)); do
    printf 'sf_%d %d\n' "$((i + 1))" "${fre[$i]}"
  done
}

# The limiter is the last node, so its -1 dBFS ceiling is what leaves the graph.
# ovs 12 is "Full x2/24 bit" oversampling: it catches inter-sample peaks, not
# just sample peaks. The envelope is LSP's Herm Thin with a 20 ms lookahead and
# attack, measured on tests/dsp-check.sh's rig: holding a sine 3 dB over the
# ceiling, the old 5 ms lookahead made 13.9 % THD at 30 Hz and 9.7 % at 50 Hz --
# the gain moved inside every bass cycle -- where 20 ms makes 0.85 % and 1.1 %,
# with no change above 200 Hz. The wider shapes and ALR all measured worse (ALR
# also holds a sustained overload ~7 dB under the ceiling). slink 100 links the
# channels, so a peak on one side lowers both and the image stays put.
limiter_values() {
  local on="${1:-on}" enabled
  case "$on" in off) enabled=0 ;; *) enabled=1 ;; esac
  printf 'enabled %s\nth %s\nlk 20\nat 20\nrt 20\nmode 0\nboost 0\nalr 0\novs 12\nslink 100\n' \
    "$enabled" "$(db_to_mult -1.0)"
}

# The leveler brings every source to one loudness -- a quiet podcast up, a loud
# master down -- before the volume, so the volume sets how loud "normal" is and
# stops being a per-app chore. LSP's autogain: K-weighted loudness over a long
# 2 s window, a -18 LUFS target, at most +12 dB of lift, nothing below -60 dB is
# treated as signal, and it rises slowly (3 dB over 2 s) but falls quickly
# (9 dB over 10 ms on the short window) so a sudden loud start is never blasted.
# Off is the plugin's own bypass, with the same values in place.
leveler_values() {
  local on="${1:-off}" enabled
  case "$on" in on) enabled=1 ;; *) enabled=0 ;; esac
  printf 'enabled %s\nscmode 0\npreamp 0\nlkahead 0\nweight 5\nlevel -18\ndrift 6\nsilence -60\n' "$enabled"
  printf 'max_on 1\nmax_amp 12\nqamp 0\nlperiod 2000\nspriod 20\n'
  printf 'vgrow_l 3\ntgrow_l 2000\nvfall_l 4\ntfall_l 1000\nvgrow_s 3\ntgrow_s 200\nvfall_s 5\ntfall_s 10\n'
}

# Render "symbol value" lines as a filter-chain control = { ... } block.
stage_controls() {
  LC_ALL=C awk '{ printf "%s\"%s\" = %s", (NR > 1 ? " " : ""), $1, $2 }'
}

# Render them as one pw-cli param list for node $1: "name:symbol value" pairs.
stage_params() {
  local name="$1"
  LC_ALL=C awk -v n="$name" '{ printf "%s\"%s:%s\" %s", (NR > 1 ? " " : ""), n, $1, $2 }'
}

# The live forms, named after the node they drive.
boost_params() { boost_values "${1:-off}" | stage_params boost; }
limiter_params() { limiter_values "${1:-on}" | stage_params limit; }
leveler_params() { leveler_values "${1:-off}" | stage_params level; }

# ---------------------------------------------------------------- channels

# The two mixers ahead of the bands: each output channel is a weighted sum of
# both inputs. Stereo passes each side through, swap crosses them, mono feeds
# both outputs half of each side -- for one earbud, or one ear that hears less --
# and the balance turns the far side down (never the near one up, so it can add
# no gain the headroom did not plan for). Lines are "node gain1 gain2".
mixer_values() {
  local channels="${1:-stereo}" balance="${2:-0}"
  LC_ALL=C awk -v c="$channels" -v b="$balance" 'BEGIN {
    gl = 1 - b; if (gl > 1) gl = 1; if (gl < 0) gl = 0
    gr = 1 + b; if (gr > 1) gr = 1; if (gr < 0) gr = 0
    if (c == "mono") { ll = 0.5; lr = 0.5; rl = 0.5; rr = 0.5 }
    else if (c == "swap") { ll = 0; lr = 1; rl = 1; rr = 0 }
    else { ll = 1; lr = 0; rl = 0; rr = 1 }
    printf "mix_l %.6f %.6f\nmix_r %.6f %.6f\n", ll * gl, lr * gl, rl * gr, rr * gr
  }'
}

mixer_controls() { # node -> control block for that mixer
  mixer_values "$2" "$3" | awk -v n="$1" '$1 == n { printf "\"Gain 1\" = %s \"Gain 2\" = %s", $2, $3 }'
}

mixer_params() { # state
  mixer_values "$(jq -r '.channels // "stereo"' <<<"$1")" "$(jq -r '.balance // 0' <<<"$1")" |
    awk '{ printf "%s\"%s:Gain 1\" %s \"%s:Gain 2\" %s", (NR > 1 ? " " : ""), $1, $2, $1, $3 }'
}

# ---------------------------------------------------------------- band pool

# With the plugins installed the graph carries the 16-slot LSP pool instead of a
# per-band biquad chain, in both modes: ten graphic bells are ten slots like any
# parametric set, so a mode switch, a preset of any shape, an import, a type,
# slope or bypass change is a values write and never a rebuild. A rebuild drops
# the sink for a moment, which pauses a browser's media and restarts the
# follower with it. Without LSP the biquads are emitted as before and a shape
# change still pays a restart. write_fragment and every live writer branch on
# the layout, never on this predicate alone.
using_para_pool() { lsp_available; }

# The layout this state needs: the pool, or the exact sequence of builtin biquad
# labels its stages make. Two states with the same layout differ only in control
# values, so moving between them is a live write.
desired_layout() {
  if using_para_pool; then
    printf 'pool\n'
  else
    printf 'biquad:%s\n' "$(stages_tsv "$(active_bands "$1")" | cut -f1 |
      while IFS= read -r t; do filter_label "$t"; printf ','; done)"
  fi
}

# The layout the running graph was built with, read from the fragment it was
# loaded from. A fragment from before the layout line (or none at all) matches
# nothing, which is what makes the first command after an upgrade rebuild once.
running_layout() {
  if [[ -f $running_layout_file ]]; then
    head -n1 "$running_layout_file"
  elif [[ -f $fragment ]]; then
    sed -n "s/^# Layout: v$layout_version //p" "$fragment" | head -n1
  fi
}

# Whether the running graph is the pool. Live writes address para:* controls only
# then; anything else addresses the biquads.
running_pool() { [[ $(running_layout) == pool ]]; }

# Whether a state's bands can be written into the running graph as values.
layout_live() { [[ $(desired_layout "$1") == "$(running_layout)" ]]; }

# "symbol value" lines for the pool's globals and all 16 slots. fm 6 is APO (DR)
# at slope x1: that mode's bell, shelf and pass coefficients, and its RBJ meaning
# of Q, are what Model.js draws and auto_preamp_db assumes (tests/dsp-check.sh
# measures every type against it). A slope is not the plugin's s control, which
# APO (DR) ignores, but extra slots: stages_tsv expands a band into the stages
# the graph runs, one per slot. q is always written (its default is 0); the
# globals are pinned because the plugin's defaults are not neutral -- the FFT
# displays would be computed on every quantum, and g_in/g_out and the display
# state left wherever the plugin chose. Unused slots are ft 0 (Off) with defined
# values in the fields a band enabled later would read.
para_values() {
  local bands="${1:-[]}"
  printf 'enabled 1\nmode 0\nreact 0.2\nshift 1\nfsel 0\nquant 0\nife_l 0\nife_r 0\nofe_l 0\nofe_r 0\nrfe_l 0\nrfe_r 0\nbal 0\ng_in 1\ng_out 1\n'
  # One jq for the whole set and one awk for the slots: the type codes are
  # para_type_code's and the gain is db_to_mult's, printed the same way. The
  # values are the plugin's own: Off 0, Bell 1, Hi-pass 2, Hi-shelf 3, Lo-pass 4,
  # Lo-shelf 5, Notch 6, Allpass 8, Bandpass 9.
  stages_tsv "$bands" | head -n "$max_slots" |
    LC_ALL=C awk -F'\t' -v slots="$max_slots" '
      BEGIN { code["peaking"] = 1; code["highpass"] = 2; code["highshelf"] = 3; code["lowpass"] = 4
              code["lowshelf"] = 5; code["notch"] = 6; code["allpass"] = 8; code["bandpass"] = 9 }
      { i = NR - 1; c = ($1 in code) ? code[$1] : 1
        printf "ft_%d %s\nfm_%d 6\ns_%d 0\nf_%d %s\nq_%d %s\ng_%d %.6f\n", i, c, i, i, i, $2, i, $4, i, 10 ^ ($3 / 20) }
      END { for (i = NR; i < slots; i++)
              printf "ft_%d 0\nfm_%d 6\ns_%d 0\nf_%d 1000\nq_%d 1.0\ng_%d 1\n", i, i, i, i, i, i }'
}

para_type_code() {
  case "$1" in
    peaking) printf 1 ;;
    highpass) printf 2 ;;
    highshelf) printf 3 ;;
    lowpass) printf 4 ;;
    lowshelf) printf 5 ;;
    notch) printf 6 ;;
    allpass) printf 8 ;;
    bandpass) printf 9 ;;
    *) printf 1 ;;
  esac
}

# The builtin biquads of a stage list, as "label freq q gain" lines.
biquad_stage_lines() {
  stages_tsv "$1" | while IFS=$'\t' read -r type freq gain q; do
    printf '%s %s %s %s %s\n' "$(filter_label "$type")" "$type" "$freq" "$q" "$gain"
  done
}

# The preamp, one value on both channels.
preamp_params() { local m; m="$(db_to_mult "${1:-0}")"; printf '"pre_l:Mult" %s "pre_r:Mult" %s' "$m" "$m"; }
relief_params() { local m; m="$(db_to_mult "${1:-0}")"; printf '"relief_l:Mult" %s "relief_r:Mult" %s' "$m" "$m"; }

# The live param list for the bands: the preamp first (a gain or type edit
# changes the automatic headroom), then the relief that goes with it, then every
# slot or biquad. One string, so one pw-cli call. need_numeric_bands runs here
# for the same reason as the fragment writer: its die only ends this command
# substitution, so the caller must carry the failure out.
build_band_params() {
  local bands="$1" preamp="${2:-0}" relief="${3:-0}" params k=0
  need_numeric_bands "$bands"
  # The preamp and the slot set share one line: a newline between them would
  # split the parameter list into two arguments, so one pw-cli call would look
  # like two to anything counting invocations.
  params="$(preamp_params "$preamp") $(relief_params "$relief")"
  if running_pool; then
    params+=" $(para_values "$bands" | stage_params para)"
  else
    # Each stage on both channels. A pass filter's Gain does nothing, so it is
    # not written (and not in the fragment either): a settable parameter that
    # moves nothing is a lie in the param list.
    while read -r label type freq q gain; do
      local ch
      for ch in l r; do
        params+=" \"g${k}_$ch:Freq\" $freq \"g${k}_$ch:Q\" $q"
        case "$type" in
          lowpass | highpass | bandpass | notch | allpass) ;;
          *) params+=" \"g${k}_$ch:Gain\" $gain" ;;
        esac
      done
      k=$((k + 1))
    done < <(biquad_stage_lines "$bands")
  fi
  printf '%s\n' "$params"
}

# A shelf's "Q" control is the slope, not a bandwidth, so a shelf band keeps its
# own value but never inherits the graphic Q.
write_fragment() {
  local state="$1" target="${2:-}" mode bands count i ctl layout lsp=false ch node
  # The backstop for a hand-edited state: both values land in the loaded config,
  # so refuse them here as the last line of defence before anything is written.
  mode="$(jq -r '.mode // "graphic"' <<<"$state")"
  need_mode "$mode"
  need_sink_name "$target"
  need_valid_state "$state"
  # The fragment always carries the curve itself, never an A/B or solo
  # override: those are transient, and a restart must come up on the real thing.
  bands="$(active_bands "$state")"
  need_numeric_bands "$bands"
  count="$(jq 'length' <<<"$bands")"
  layout="$(desired_layout "$state")"
  using_para_pool && lsp=true

  state_dir_ensure
  mkdir -p "$fragment_dir"

  local channels balance preamp relief cur_l cur_r
  channels="$(jq -r '.channels // "stereo"' <<<"$state")"
  balance="$(jq -r '.balance // 0' <<<"$state")"
  preamp="$(jq -r '.preamp // 0' <<<"$state")"
  relief="$(jq -r '.relief // 0' <<<"$state")"

  {
    printf '# Generated by omarchy-equalizer -- do not edit by hand.\n'
    printf '# Mode: %s, %s band(s).\n' "$mode" "$count"
    printf '# Layout: v%s %s\n\n' "$layout_version" "$layout"
    printf 'context.modules = [\n  { name = libpipewire-module-filter-chain\n    args = {\n'
    printf '      node.description = "Equalizer"\n'
    printf '      media.name       = "Equalizer"\n\n'
    printf '      filter.graph = {\n        nodes = [\n'

    # The preamp is a plain linear gain node per channel, first in the chain, so
    # a profile's negative preamp can be applied -- and moved live --
    # independently of the bands.
    for ch in l r; do
      printf '          { type = builtin name = pre_%s label = linear control = { "Mult" = %s "Add" = 0 } }\n' \
        "$ch" "$(db_to_mult "$preamp")"
    done
    for ch in l r; do
      printf '          { type = builtin name = mix_%s label = mixer control = { %s } }\n' \
        "$ch" "$(mixer_controls "mix_$ch" "$channels" "$balance")"
    done

    if $lsp; then
      # One LV2 node for every slot of either mode. The controls cover all 16
      # slots whether or not each one carries a stage.
      printf '          { type = lv2 name = para plugin = "%s" control = { %s } }\n' \
        "$lsp_para_uri" "$(para_values "$bands" | stage_controls)"
    else
      i=0
      while read -r label type freq q gain; do
        # A shelving or pass filter ignores Gain/Freq mismatches gracefully, but
        # emitting an unused control would show up as a settable parameter that
        # does nothing -- so each label only carries the controls it honours.
        case "$type" in
          lowpass | highpass | bandpass | notch | allpass) ctl="\"Freq\" = $freq \"Q\" = $q" ;;
          *) ctl="\"Freq\" = $freq \"Q\" = $q \"Gain\" = $gain" ;;
        esac
        for ch in l r; do
          printf '          { type = builtin name = g%d_%s label = %s control = { %s } }\n' "$i" "$ch" "$label" "$ctl"
        done
        i=$((i + 1))
      done < <(biquad_stage_lines "$bands")
    fi

    if $lsp; then
      printf '          { type = lv2 name = level plugin = "%s" control = { %s } }\n' \
        "$lsp_autogain_uri" "$(leveler_values "$(jq -r '.leveler // "off"' <<<"$state")" | stage_controls)"
      printf '          { type = lv2 name = boost plugin = "%s" control = { %s } }\n' \
        "$lsp_mb_compressor_uri" "$(boost_values "$(jq -r '.boost // "off"' <<<"$state")" | stage_controls)"
    fi
    for ch in l r; do
      printf '          { type = builtin name = relief_%s label = linear control = { "Mult" = %s "Add" = 0 } }\n' \
        "$ch" "$(db_to_mult "$relief")"
    done
    for ch in l r; do
      printf '          { type = builtin name = vol_%s label = linear control = { "Mult" = 1 "Add" = 0 } }\n' "$ch"
    done
    if $lsp; then
      printf '          { type = lv2 name = limit plugin = "%s" control = { %s } }\n' \
        "$lsp_limiter_uri" "$(limiter_values "$(jq -r '.limiter // "on"' <<<"$state")" | stage_controls)"
    fi

    printf '        ]\n'
    printf '        links = [\n'
    # Both preamps feed both mixers: a mixer's In 1 is the left input, In 2 the
    # right, whatever the channel mode makes of them.
    printf '          { output = "pre_l:Out" input = "mix_l:In 1" }\n'
    printf '          { output = "pre_r:Out" input = "mix_l:In 2" }\n'
    printf '          { output = "pre_l:Out" input = "mix_r:In 1" }\n'
    printf '          { output = "pre_r:Out" input = "mix_r:In 2" }\n'
    cur_l="mix_l:Out" cur_r="mix_r:Out"
    if $lsp; then
      for node in para level boost; do
        printf '          { output = "%s" input = "%s:in_l" }\n' "$cur_l" "$node"
        printf '          { output = "%s" input = "%s:in_r" }\n' "$cur_r" "$node"
        cur_l="$node:out_l" cur_r="$node:out_r"
      done
    else
      for ((i = 0; i < $(biquad_stage_lines "$bands" | wc -l); i++)); do
        printf '          { output = "%s" input = "g%d_l:In" }\n' "$cur_l" "$i"
        printf '          { output = "%s" input = "g%d_r:In" }\n' "$cur_r" "$i"
        cur_l="g${i}_l:Out" cur_r="g${i}_r:Out"
      done
    fi
    for node in relief vol; do
      printf '          { output = "%s" input = "%s_l:In" }\n' "$cur_l" "$node"
      printf '          { output = "%s" input = "%s_r:In" }\n' "$cur_r" "$node"
      cur_l="${node}_l:Out" cur_r="${node}_r:Out"
    done
    if $lsp; then
      printf '          { output = "%s" input = "limit:in_l" }\n' "$cur_l"
      printf '          { output = "%s" input = "limit:in_r" }\n' "$cur_r"
      cur_l="limit:out_l" cur_r="limit:out_r"
    fi
    printf '        ]\n'
    printf '        inputs  = [ "pre_l:In" "pre_r:In" ]\n'
    printf '        outputs = [ "%s" "%s" ]\n' "$cur_l" "$cur_r"
    # The sink's volume lands on these two controls instead of the stream's own
    # software volume, which would apply it before the graph.
    printf '        capture.volumes = [\n'
    printf '          { control = "vol_l:Mult" }\n'
    printf '          { control = "vol_r:Mult" }\n'
    printf '        ]\n'
    printf '      }\n\n'
    printf '      audio.channels = 2\n'
    printf '      audio.position = [ FL FR ]\n'
    printf '      capture.props  = { node.name = "%s" node.description = "Equalizer" media.class = Audio/Sink }\n' "$sink_name"
    printf '      playback.props = { node.name = "%s.output" node.passive = true target.object = "%s" }\n' "$sink_name" "$target"
    printf '    }\n  }\n]\n'
  } >"$fragment.tmp"

  mv "$fragment.tmp" "$fragment"
}

# The preamp and headroom are live controls, so a hand-set preamp used to live on
# in the running graph while the fragment on disk still carried the value from the
# last rebuild -- the config on disk did not describe what you were hearing, and a
# later restart came up with a different chain. Rewrite the fragment with every
# preamp change; it costs one file write, and the two can no longer disagree.
sync_fragment() {
  local state="$1" target
  target="$(jq -r '.targetSink // ""' <<<"$state")"
  # Keep an existing fragment in step; do not create one on a machine that has
  # never been enabled, where there is no target to name and nothing to read it.
  [[ -n $target || -f $fragment ]] || return 0
  place_graph "$state" "$target"
}

# Write the fragment for a state, and rebuild the running graph if the fragment's
# layout is not the one it runs: a values-only rewrite (a new target, a preamp, a
# stage toggle) never restarts, but a fragment of another shape must never sit
# on disk under a graph that cannot take its live writes -- right after an
# upgrade, or once LSP has been installed or removed. graph_rebuilt says it did,
# so a caller about to write the same values live can skip that.
graph_rebuilt=0
place_graph() {
  local state="$1" target="$2"
  graph_rebuilt=0
  write_fragment "$state" "$target"
  if [[ $(desired_layout "$state") != "$(running_layout)" ]] && sink_present; then
    service_restart >/dev/null 2>&1
    graph_rebuilt=1
  fi
  return 0
}

# The rate the graph runs the filters at. The response curve needs it: 16 kHz
# sits much closer to Nyquist at 44.1 kHz than at 48 kHz, and the curve is drawn
# from the same formulas the filters run. A running equalizer sink reports the
# rate it is negotiated at -- which, with clock.allowed-rates, follows whatever
# the hardware and the first stream settled on -- and pactl prints it for free
# on the line sink_present already reads; an idle one falls back to the
# configured clock rate, the rate it will start at.
graph_rate() {
  local rate
  rate="$(pactl list sinks short 2>/dev/null | awk -v n="$sink_name" '
    $2 == n && $NF == "RUNNING" { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+Hz$/) { sub(/Hz$/, "", $i); print $i; exit } }')"
  is_number "$rate" ||
    rate="$(pw-metadata -n settings 0 clock.rate 2>/dev/null | awk -F"'" '/value:/ {print $4; exit}')"
  is_number "$rate" || rate=48000
  printf '%.0f\n' "$rate"
}

# Live updates: write the running graph's controls in one pw-cli call.
find_node_id() {
  pw-dump 2>/dev/null | jq -r --arg n "$sink_name" '
    .[] | select(.type == "PipeWire:Interface:Node")
        | select(.info.props["node.name"]? == $n) | .id' | head -n1
}

# Send one parameter list to the running graph. Passing the node id saves a
# pw-dump per step when a caller writes the same node repeatedly.
live_send_params() {
  local params="$1" id="${2:-}"
  [[ -n $id ]] || id="$(find_node_id)"
  [[ -n $id ]] || return 1
  # pw-cli needs the params as a spa pod struct; one call keeps every band
  # consistent with the same audio quantum.
  pw-cli set-param "$id" Props "{ params = [ $params ] }" >/dev/null 2>&1
}

# The bands, preamp and relief the graph should be playing right now: the state's
# own, or the A/B and solo overrides (see listen_bands).
live_apply_bands() {
  local state="$1" params
  # build_band_params refuses a non-numeric band from inside a command
  # substitution, so its die only ends that subshell: carry the failure out here
  # rather than send an empty parameter list.
  params="$(build_band_params "$(listen_bands "$state")" "$(listen_preamp "$state")" "$(jq -r '.relief // 0' <<<"$state")")" || exit 1
  live_send_params "$params"
}

# Write the active band set to whatever the running graph holds. The fragment is
# kept in step, because it carries the band values; a live write that cannot
# find the node, or a graph of another layout, rebuilds instead, so a sink torn
# down under us still comes back correct.
live_apply_active() {
  local state="$2"
  if ! layout_live "$state"; then
    # The running graph is another shape: its controls have other names, so a
    # live write would land on nothing. Rebuild it as the state says.
    write_fragment "$state" "$(jq -r '.targetSink // ""' <<<"$state")"
    service_restart >/dev/null 2>&1
    return
  fi
  sync_fragment "$state"
  live_apply_bands "$state" || service_restart >/dev/null 2>&1
}

# One interpolation step between two shape-compatible band sets. Frequency moves
# geometrically -- linearly in log-frequency -- so a sweep sounds even; the rest
# is plain linear. Callers only use this when both sets have the same layout, so
# the indices line up.
interpolate_bands() {
  local from="$1" to="$2" t="$3"
  jq -c -n --argjson f "$from" --argjson g "$to" --argjson k "$t" '
    [ range(0; ($f | length)) as $i
      | $g[$i] + { type: ($f[$i].type // "peaking"),
          freq: (($f[$i].freq // 1000) * pow((($g[$i].freq // 1000) / ($f[$i].freq // 1000)); $k)),
          q: (($f[$i].q // 1.0) + (($g[$i].q // 1.0) - ($f[$i].q // 1.0)) * $k),
          gain: (($f[$i].gain // 0) + (($g[$i].gain // 0) - ($f[$i].gain // 0)) * $k) } ]'
}

# Cross-fade a shape-compatible change over eight short steps. Each step sends
# the whole control set in one pw-cli call, so the graph is never half-updated;
# the last step writes the exact targets so rounding can never leave a band a
# hair off its preset value. OMARCHY_EQ_NO_RAMP=1 collapses this to the single
# target write (the tests use it to avoid the sleeps where they do not assert on
# the fade itself).
live_ramp_bands() {
  local from_bands="$1" to_bands="$2" from_preamp="$3" to_preamp="$4" relief="${5:-0}" id k t step_bands step_preamp params
  id="$(find_node_id)"
  [[ -n $id ]] || return 1
  if [[ ${OMARCHY_EQ_NO_RAMP:-} == 1 ]]; then
    params="$(build_band_params "$to_bands" "$to_preamp" "$relief")" || exit 1
    live_send_params "$params" "$id"
    return
  fi
  for ((k = 1; k <= 8; k++)); do
    if ((k == 8)); then
      step_bands="$to_bands"
      step_preamp="$to_preamp"
    else
      t="$(LC_ALL=C awk -v k="$k" 'BEGIN { printf "%.6f", k / 8 }')"
      step_bands="$(interpolate_bands "$from_bands" "$to_bands" "$t")"
      step_preamp="$(LC_ALL=C awk -v a="$from_preamp" -v b="$to_preamp" -v t="$t" \
        'BEGIN { printf "%.6f", a + (b - a) * t }')"
    fi
    params="$(build_band_params "$step_bands" "$step_preamp" "$relief")" || exit 1
    live_send_params "$params" "$id"
    if ((k < 8)); then sleep 0.02; fi
  done
}

# ---------------------------------------------------------------- listening overrides
#
# Two ways to hear something other than the curve without changing it, both
# transient: the A/B ("flat": the bands out, played at the curve's own loudness,
# so the comparison is tone and not volume) and solo (one band alone). They live
# in state.listen so the panel can show them, never in the fragment, and any edit
# that changes the curve ends them -- apply_headroom drops the field.

# The bands the graph should run under the current override. On the pool a band
# that is out is simply Off; the biquad chain cannot change shape live, so there
# the gain of every other band goes to zero instead (a pass filter stays, which
# is the most a live write can do -- the level match below accounts for it).
listen_bands() {
  local state="$1" bands
  bands="$(active_bands "$state")"
  jq -c --argjson pool "$(using_para_pool && echo true || echo false)" --argjson l "$(jq -c '.listen // null' <<<"$state")" '
    if $l == null then .
    elif $l.mode == "flat" then
      (if $pool then map(.enabled = false) else map(.gain = 0) end)
    elif $l.mode == "solo" then
      (to_entries | map(if .key == ($l.band // -1) then .value
        elif $pool then .value + { enabled: false } else .value + { gain: 0 } end))
    else . end' <<<"$bands"
}

# The preamp under the override: the A/B plays Flat at the curve's loudness, so it
# carries the level the backend computed when it was switched on.
listen_preamp() {
  jq -r 'if (.listen.mode // "") == "flat" then (.listen.preamp // 0) else (.preamp // 0) end' <<<"$1"
}

sink_exists() {
  pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -Fx -- "$1" >/dev/null
}

sink_present() {
  sink_exists "$sink_name"
}

# The physical output the equalizer should play into.
current_default_sink() { pactl get-default-sink 2>/dev/null; }
# The physical output whose volume and mute the user really hears: resolve through
# any DSP sink (the Asahi speaker tuning, an earlier EasyEffects) down to the
# hardware it feeds. Used when the EQ is switched off and a default output has to
# be restored to something that still exists.
physical_output() {
  local sink
  sink="$(current_default_sink)"
  # While the equalizer is on, the default sink IS the equalizer; what it plays
  # into is the remembered target, not itself.
  if [[ $sink == "$sink_name" ]]; then
    sink="$(state_read | jq -r '.targetSink // empty')"
  elif [[ -n $sink ]]; then
    local resolved
    resolved="$(omarchy-audio-output-sink 2>/dev/null)"
    [[ -n $resolved ]] && sink="$resolved"
  fi
  [[ -z $sink ]] && sink="$(first_output_sink)"
  printf '%s\n' "$sink"
}

first_output_sink() {
  pactl list sinks short 2>/dev/null | awk -v self="$sink_name" '$2 != self {print $2; exit}'
}

# Where the chain should play. A DSP sink that is already selected is a
# destination, not something to resolve past: chaining in front of it keeps that
# correction in the signal path, and the volume the user sees still lands on the
# hardware underneath. Resolving through it to the hardware (which is what
# physical_output and omarchy-audio-output-sink are for) would silently drop the
# speaker tuning for as long as the equalizer was on -- on an Asahi laptop that is
# the largest single improvement to the built-in speakers.
chain_target() {
  local sink
  sink="$(current_default_sink)"
  # While the equalizer is on, the default sink IS the equalizer; what it plays
  # into is the remembered target, not itself.
  if [[ $sink == "$sink_name" ]]; then
    sink="$(state_read | jq -r '.targetSink // empty')"
  fi
  [[ -z $sink ]] && sink="$(first_output_sink)"
  printf '%s\n' "$sink"
}

# Application streams only: a filter-chain's own output is a sink input too, and
# moving it would rewire the EQ into itself.
# Every application stream, one per line: id, sink index, application name and
# process binary, tab-separated. A stream without an application.name is not an
# app -- the filter-chain's own output is a sink input too, and moving it would
# rewire the EQ into itself -- and the EQ's output stream is skipped by name as
# well, so nothing here can ever move it.
app_stream_table() {
  pactl list sink-inputs 2>/dev/null | awk -v self="$sink_name.output" '
    function flush() {
      if (id != "" && name != "" && node != self) printf "%s\t%s\t%s\t%s\n", id, sink, name, bin
      id = ""; sink = ""; name = ""; bin = ""; node = ""
    }
    function value(line) { sub(/^[^"]*"/, "", line); sub(/"[[:space:]]*$/, "", line); return line }
    /^Sink Input #/ { flush(); id = substr($3, 2) }
    /^\tSink: / { sink = $2 }
    /application\.name = / { name = value($0) }
    /application\.process\.binary = / { bin = value($0) }
    /node\.name = / { node = value($0) }
    END { flush() }'
}

app_streams() { app_stream_table | cut -f1; }

# The application streams playing into the equalizer sink right now.
app_streams_on_eq() {
  local index
  index="$(sink_index "$sink_name")"
  [[ -n $index ]] || return 0
  app_stream_table | awk -F'\t' -v want="$index" '$2 == want { print $1 }'
}

# Whether an app is one the user keeps off the equalizer: its application name or
# its process binary, compared without case, is on the excluded list. A call app,
# a DAW, a game with its own EQ -- they play straight to the device.
app_is_excluded() { # name binary excluded-json
  jq -e -n --arg n "$1" --arg b "$2" --argjson x "${3:-[]}" '
    ($x | map(ascii_downcase)) as $l | ($l | index($n | ascii_downcase)) != null
      or ($b != "" and ($l | index($b | ascii_downcase)) != null)' >/dev/null 2>&1
}

# Move every app stream to $1, except the excluded ones, which go to $2 (the
# device) when given. A disable passes the same sink twice: everything leaves the
# equalizer then.
move_apps_to() {
  local target="$1" bypass="${2:-$1}" excluded id sink name bin
  [[ -z $target ]] && return 0
  excluded="$(state_read | jq -c '.excludedApps // []')"
  while IFS=$'\t' read -r id sink name bin; do
    [[ -n $id ]] || continue
    if [[ $bypass != "$target" ]] && app_is_excluded "$name" "$bin" "$excluded"; then
      pactl move-sink-input "$id" "$bypass" 2>/dev/null || true
    else
      pactl move-sink-input "$id" "$target" 2>/dev/null || true
    fi
  done < <(app_stream_table)
}

# The follower's half of the exclusions: an excluded app that WirePlumber put on
# the equalizer (it is the default sink, so a new stream lands there) is moved to
# the device the equalizer plays into.
converge_excluded() {
  local state target index excluded id sink name bin
  state="$(state_read)"
  excluded="$(jq -c '.excludedApps // []' <<<"$state")"
  [[ $excluded != "[]" ]] || return 0
  target="$(jq -r '.targetSink // ""' <<<"$state")"
  [[ -n $target ]] && sink_exists "$target" || return 0
  index="$(sink_index "$sink_name")"
  while IFS=$'\t' read -r id sink name bin; do
    [[ -n $id && $sink == "$index" ]] || continue
    if app_is_excluded "$name" "$bin" "$excluded"; then
      echo "omarchy-equalizer: $name is excluded; playing it straight to $target" >&2
      pactl move-sink-input "$id" "$target" >/dev/null 2>&1 || true
    fi
  done < <(app_stream_table)
}

# Sink-input id of the EQ's own output stream (what plays into the device).
eq_output_input_id() {
  pactl list sink-inputs 2>/dev/null | awk -v n="node.name = \"$sink_name.output\"" '
    /^Sink Input #/ {id = substr($3, 2)}
    index($0, n) {print id; exit}'
}

# The sink NAME the EQ's own output stream is actually linked to. A live
# move-sink-input only redirects for the moment: nothing on the pulse or pw
# surface pins a stream's target.object, so WirePlumber is free to relink the
# stream again at any default change -- one second after the user picks a
# device, their stream can be on the highest-priority sink while the state and
# the fragment both name what they chose. The remembered target is therefore the
# authority and the actual sink must be read back instead of assumed.
eq_output_aim() {
  local want="${1:-}" aim
  [[ -n $want ]] || want="$(eq_output_input_id)"
  [[ -n $want ]] || return 0
  aim="$(pactl list sink-inputs 2>/dev/null | awk -v want="$want" '
    /^Sink Input #/  {cur = substr($3, 2)}
    /^	Sink: / && cur == want {sub(/.*Sink: /, ""); print; exit}')"
  [[ -n $aim ]] && pactl list sinks short 2>/dev/null | awk -v i="$aim" '$1 == i {print $2; exit}'
}

write_unit() {
  mkdir -p "$config_home/systemd/user"
  cat >"$unit" <<EOF
[Unit]
Description=Omarchy equalizer filter-chain
Documentation=https://github.com/basecamp/omarchy
After=pipewire.service wireplumber.service
Requires=pipewire.service
Wants=wireplumber.service
PartOf=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c omarchy-equalizer.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
EOF
  cat >"$follow_unit" <<EOF
[Unit]
Description=Omarchy equalizer output follower
After=$unit_name
BindsTo=$unit_name
PartOf=$unit_name

[Service]
Type=simple
ExecStart=$script_path follow
Restart=on-failure
RestartSec=2

[Install]
WantedBy=$unit_name
EOF
}

# The layout of the graph the unit is actually running: recorded whenever it is
# started from the fragment on disk -- by enable, by a restart here, and by the
# follower, which systemd starts together with the unit (that covers a restart
# systemd makes on its own). A fragment rewritten later without a restart (a new
# target, a preamp) keeps its layout, so the record stays true; a different
# layout is only ever written together with a restart (place_graph).
note_running_layout() {
  state_dir_ensure
  sed -n "s/^# Layout: v$layout_version //p" "$fragment" 2>/dev/null | head -n1 >"$running_layout_file"
}

service_start() {
  # The service name comes from the config's own filename, which is what lets a
  # private config name keep the EQ out of the shared filter-chain namespace.
  cp "$plugin_dir/host/omarchy-equalizer.conf" "$host_config"
  write_unit
  systemctl --user daemon-reload >/dev/null 2>&1
  systemctl --user enable --now "$unit_name" "$follow_unit_name" >/dev/null 2>&1
  note_running_layout
  local _
  for _ in {1..40}; do
    sink_present && return 0
    systemctl --user is-active --quiet "$unit_name" || return 1
    sleep 0.25
  done
  sink_present
}

service_stop() {
  systemctl --user disable --now "$follow_unit_name" "$unit_name" >/dev/null 2>&1
  systemctl --user daemon-reload >/dev/null 2>&1
  local _
  for _ in {1..20}; do sink_present || return 0; sleep 0.25; done
  return 0
}

# A restart tears the EQ sink down and builds a new one. An app playing into it
# sees its output device vanish, and a browser takes that as a reason to pause
# the media -- every preset that changes the graph's shape (a graphic preset to a
# parametric one) used to stop the song. Park the app streams on the device the
# EQ plays into first, so they keep playing (unequalized for the moment the
# rebuild takes), and bring them back once the new sink is up.
service_restart() {
  local target parked=() id _ old_index index gone=false state
  target="$(state_read | jq -r '.targetSink // empty')"
  if [[ -n $target && $target != "$sink_name" ]] && sink_exists "$target"; then
    mapfile -t parked < <(app_streams_on_eq)
    old_index="$(sink_index "$sink_name")"
    for id in "${parked[@]}"; do
      pactl move-sink-input "$id" "$target" >/dev/null 2>&1 || true
    done
  fi
  systemctl --user restart "$unit_name" >/dev/null 2>&1
  note_running_layout
  if ((${#parked[@]})); then
    # Right after the restart pactl can still list the old sink for a moment,
    # and moving the streams back onto it would strand them on the device when
    # it goes. Wait until the sink has been seen gone or comes back under a new
    # index; PipeWire may reuse the index, so give up waiting on that after
    # OMARCHY_EQ_RESTART_SETTLE seconds and take the sink that is there.
    for _ in $(seq 1 $((${OMARCHY_EQ_RESTART_SETTLE:-2} * 20))); do
      index="$(sink_index "$sink_name")"
      [[ -z $index ]] && gone=true
      [[ -n $index ]] && { $gone || [[ $index != "$old_index" ]]; } && break
      sleep 0.05
    done
  fi
  for _ in $(seq 1 $((${OMARCHY_EQ_RESTART_TIMEOUT:-10} * 4))); do sink_present && break; sleep 0.25; done
  if ! sink_present; then
    # The sink did not come back in time. Remember the parked streams, so the
    # follower's next pass returns them once systemd brings the sink up again;
    # otherwise they would play unequalized on the device for good.
    if ((${#parked[@]})); then
      state="$(state_read)"
      state="$(jq -c --argjson ids "$(printf '%s\n' "${parked[@]}" | jq -R 'tonumber? // empty' | jq -sc '.')" \
        '.parkedStreams = ((.parkedStreams // []) + $ids | unique)' <<<"$state")"
      state_write "$state"
    fi
    return 1
  fi
  ((${#parked[@]})) && return_parked_streams "${parked[@]}"
  return 0
}

# Bring streams parked by a restart back onto the equalizer. Losing the sink
# also cost it the default; take that back, as enable does. A stream that has
# ended since is simply gone, and its failed move is not an error.
return_parked_streams() {
  local id
  pactl set-default-sink "$sink_name" >/dev/null 2>&1
  for id in "$@"; do
    pactl move-sink-input "$id" "$sink_name" >/dev/null 2>&1 || true
  done
}

sink_index() {
  pactl list sinks short 2>/dev/null | awk -v n="$1" '$2 == n {print $1; exit}'
}

# ---------------------------------------------------------------- commands

cmd_enable() {
  local state default target
  state="$(state_read)"
  if [[ $(jq -r '.enabled' <<<"$state") == true ]] && sink_present; then
    return 0
  fi

  default="$(current_default_sink)"
  target="$(chain_target)"
  [[ -n $target ]] || die "No output sink to equalize."
  # Refuse a name that would break out of the quoted target at its source, so it
  # is never remembered in the state rather than caught later by the writer.
  need_sink_name "$target"

  # A fresh graph starts on the curve itself (no A/B or solo carried over) and
  # with no volume relief: the sink and its volume do not exist until it is up,
  # and the follower's first pass gives the relief back once they do.
  state="$(jq -c 'del(.listen) | .relief = 0' <<<"$state")"
  write_fragment "$state" "$target"
  service_start || die "The equalizer filter-chain failed to start."

  # The previous default is remembered so turning the EQ off can restore exactly
  # the output the user had selected.
  state="$(jq -c --arg prev "$default" --arg tgt "$target" '
    .enabled = true | .previousDefaultSink = $prev | .targetSink = $tgt
    | .targetPickedAt = (now | floor) | del(.seenSinks)' <<<"$state")"
  state_write "$state"

  pactl set-default-sink "$sink_name" >/dev/null 2>&1
  # Excluded apps go straight to the device instead.
  move_apps_to "$sink_name" "$target"
  # The device may remember a curve of its own.
  ( device_memory_pass ) || true
}

cmd_disable() {
  local state restore
  state="$(state_read)"
  restore="$(jq -r '.previousDefaultSink // ""' <<<"$state")"

  # Recompute the hardware sink rather than trusting the remembered one: the
  # remembered value may itself be a tuning that has since been removed.
  local fallback
  fallback="$(physical_output)"

  service_stop

  if [[ -n $restore ]] && sink_exists "$restore"; then
    pactl set-default-sink "$restore" >/dev/null 2>&1
    move_apps_to "$restore"
  elif [[ -n $fallback ]]; then
    pactl set-default-sink "$fallback" >/dev/null 2>&1
    move_apps_to "$fallback"
  fi

  state="$(jq -c '.enabled = false' <<<"$state")"
  state_write "$state"
}

# Follow an output change made while the EQ is on. Connecting headphones makes
# WirePlumber set them as the default sink; apps follow and bypass the EQ, which
# keeps playing into the old device, so every dial moves a chain nobody hears.
# Re-aim the EQ at the new device (live stream move, no restart) and take the
# default back.
retarget_routing() {
  local state default target id live aim now gone since sibling preferred seen parked=()
  local grace="${OMARCHY_EQ_VANISH_GRACE:-5}"
  retarget_pending=0
  converge_moved=0
  state="$(state_read)"
  [[ $(jq -r '.enabled' <<<"$state") == true ]] || return 0
  sink_present || return 0
  # Streams a failed restart parked on the device come home once the sink is
  # back (systemd's Restart= brings it up after service_restart gave up).
  if [[ $(jq '.parkedStreams // [] | length' <<<"$state") -gt 0 ]]; then
    mapfile -t parked < <(jq -r '.parkedStreams[]' <<<"$state")
    return_parked_streams "${parked[@]}"
    state="$(jq -c 'del(.parkedStreams)' <<<"$state")"
    state_write "$state"
  fi
  default="$(current_default_sink)"
  [[ -n $default ]] || return 0

  # With the EQ on, the default sink is the EQ itself, so a removed device never
  # shows up here as a changed default -- yet the device its target names can be
  # gone all the same: a Bluetooth device that sleeps, errors, or is switched off
  # vanishes from pactl, and the EQ then plays into a name that no longer exists.
  # The graph looks healthy and sound stops everywhere. Validate the remembered
  # target on every pass: a dead one is replaced by a device that still exists
  # (a live stream move, no restart), the same live recovery the path below does
  # for a user's new pick; with nothing else live the dead target is kept for
  # when the device returns. The user's previous default is left alone so a later
  # disable still restores the device they actually chose.
  if [[ $default == "$sink_name" ]]; then
    target="$(jq -r '.targetSink // empty' <<<"$state")"
    [[ -n $target ]] || return 0
    # The device the user picked is previousDefaultSink: enable and the manual
    # path below both set it to the same name as the target, and only the
    # fallback further down parts the two. So when they differ and the pick is
    # live again -- the headset came back after the grace period ran out -- go
    # back to it. Without this, WirePlumber relinks the stream to the returning
    # headset and the convergence below drags it back to the fallback.
    preferred="$(jq -r '.previousDefaultSink // empty' <<<"$state")"
    if [[ -n $preferred && $preferred != "$target" && $preferred != "$sink_name" ]]; then
      if ! sink_exists "$preferred" && [[ $preferred == bluez_output.*.* ]]; then
        preferred="$(pactl list sinks short 2>/dev/null | awk -v p="${preferred%.*}." 'index($2, p) == 1 {print $2; exit}')"
      fi
      if [[ -n $preferred && $preferred != "$target" ]] && sink_exists "$preferred"; then
        need_sink_name "$preferred"
        echo "omarchy-equalizer: $preferred is back, aiming at it again instead of $target" >&2
        state="$(jq -c --arg tgt "$preferred" '
          .targetSink = $tgt | .previousDefaultSink = $tgt | .targetPickedAt = (now | floor)
          | del(.vanishedTargetSink, .targetMissingSince)' <<<"$state")"
        state_write "$state"
        place_graph "$state" "$preferred"
        target="$preferred"
      fi
    fi
    if sink_exists "$target"; then
      # Back (or never gone): forget any vanish in progress.
      if [[ -n $(jq -r '.vanishedTargetSink // empty' <<<"$state") ]]; then
        state="$(jq -c 'del(.vanishedTargetSink, .targetMissingSince)' <<<"$state")"
        state_write "$state"
      fi
    else
      # A Bluetooth profile switch (A2DP <-> HFP) or a short sleep drops the sink
      # and re-creates it a moment later, sometimes under a new profile suffix
      # (bluez_output.MAC.1 -> .2). The first pass only notes the vanish; a
      # sibling of the same device is adopted at once, and anything else waits
      # out a grace period before the fallback overwrites the target.
      now="$(date +%s)"
      gone="$(jq -r '.vanishedTargetSink // empty' <<<"$state")"
      since="$(jq -r '.targetMissingSince // 0' <<<"$state")"
      if [[ $gone != "$target" ]]; then
        since="$now"
        state="$(jq -c --arg g "$target" --argjson t "$now" '.vanishedTargetSink = $g | .targetMissingSince = $t' <<<"$state")"
        state_write "$state"
      fi
      sibling=""
      if [[ $target == bluez_output.*.* ]]; then
        sibling="$(pactl list sinks short 2>/dev/null | awk -v p="${target%.*}." 'index($2, p) == 1 {print $2; exit}')"
      fi
      if [[ -n $sibling ]]; then
        need_sink_name "$sibling"
        state="$(jq -c --arg tgt "$sibling" '.targetSink = $tgt | .targetPickedAt = (now | floor) | del(.vanishedTargetSink, .targetMissingSince)' <<<"$state")"
        state_write "$state"
        place_graph "$state" "$sibling"
        target="$sibling"
      elif ((now - since < grace)); then
        retarget_pending=1
        return 0
      else
      # Adopt where WirePlumber already put the stream: a live sink that
      # reflects priority and availability, unlike listing order (creation
      # order -- on an Asahi Mac the raw hardware sink precedes the J313
      # tuning sink, so first_output_sink routes around the tuning).
      live="$(eq_output_aim)"
      [[ $live != "$sink_name" ]] || live=""
      [[ -n $live ]] || live="$(first_output_sink)"
      [[ -n $live ]] || return 0
      need_sink_name "$live"
      state="$(jq -c --arg tgt "$live" '.targetSink = $tgt | .targetPickedAt = (now | floor) | del(.vanishedTargetSink, .targetMissingSince)' <<<"$state")"
      state_write "$state"
      place_graph "$state" "$live"
      target="$live"
      fi
    fi
    # And whatever the target is now, the stream itself has to be on it: a live
    # move pins nothing, so WirePlumber relinks the stream on its own afterwards
    # and the one-second swing of issue #2 -- stream on the highest-priority
    # sink, state naming the picked device -- is exactly this disagreement seen
    # the other way. Read the aim back every pass and move over when it differs.
    # When each output first showed up, so a device that connects can be told
    # from one that was already there. A sink that goes away is dropped, so the
    # same headset reconnecting counts as new again. On the first pass every
    # sink present counts as old.
    seen="$(pactl list sinks short 2>/dev/null | awk '{print $2}' | jq -R . | jq -sc --argjson old "$(jq -c '.seenSinks // null' <<<"$state")" '
      (now | floor) as $now
      | map({ key: ., value: (if $old == null then 0 else ($old[.] // $now) end) }) | from_entries')"
    if [[ $seen != "$(jq -c '.seenSinks // null' <<<"$state")" ]]; then
      state="$(jq -c --argjson s "$seen" '.seenSinks = $s' <<<"$state")"
      state_write "$state"
    fi
    id="$(eq_output_input_id)"
    [[ -n $id ]] || return 0
    aim="$(eq_output_aim "$id")"
    # WirePlumber relinks the stream to an output that connects -- that is how a
    # headset taking over looks while the EQ holds the default, and it is what
    # WirePlumber would have made the default otherwise. An output that appeared
    # after the target was picked and now carries the stream is the user's new
    # device: follow it. One that was already there is issue #2's relink to the
    # highest-priority sink, and the stream is moved back below.
    if [[ -n $aim && $aim != "$target" && $aim != "$sink_name" ]] && sink_exists "$aim" &&
       [[ $(jq --arg a "$aim" '(.seenSinks[$a] // 0) > (.targetPickedAt // 0)' <<<"$state") == true ]]; then
      need_sink_name "$aim"
      echo "omarchy-equalizer: $aim connected and the stream is on it; following it from $target" >&2
      state="$(jq -c --arg tgt "$aim" '
        .targetSink = $tgt | .previousDefaultSink = $tgt | .targetPickedAt = (now | floor)
        | del(.vanishedTargetSink, .targetMissingSince)' <<<"$state")"
      state_write "$state"
      place_graph "$state" "$aim"
      target="$aim"
    fi
    if [[ $aim != "$target" ]]; then
      converge_moved=1
      echo "omarchy-equalizer: stream $id was aimed at ${aim:-?}, moving it to $target" >&2
      pactl move-sink-input "$id" "$target" >/dev/null 2>&1 ||
        echo "omarchy-equalizer: moving stream $id to $target failed" >&2
    fi
    return 0
  fi

  target="$(chain_target)"
  [[ -n $target && $target != "$sink_name" ]] || return 0
  need_sink_name "$target"
  state="$(jq -c --arg prev "$default" --arg tgt "$target" '.previousDefaultSink = $prev | .targetSink = $tgt | .targetPickedAt = (now | floor)' <<<"$state")"
  state_write "$state"
  place_graph "$state" "$target"
  # Default first: the relink it triggers lands before the move, so the move is
  # the last word and pins the stream on the pick (issue #2).
  pactl set-default-sink "$sink_name" >/dev/null 2>&1
  id="$(eq_output_input_id)"
  [[ -n $id ]] && pactl move-sink-input "$id" "$target" >/dev/null 2>&1
  move_apps_to "$sink_name"
}

# One follower pass, or a hand-run retarget: route first (where the EQ plays and
# which device it is), then bring the rest in line with that -- the device's own
# curve, the headroom the volume gives back, and the apps kept off the EQ.
cmd_retarget() {
  retarget_routing
  local state
  state="$(state_read)"
  [[ $(jq -r '.enabled' <<<"$state") == true ]] || return 0
  sink_present || return 0
  # A failure in one of these must not end the follower, which runs this in a
  # loop: each runs in its own subshell, so its die only ends that.
  ( device_memory_pass ) || true
  ( refresh_relief ) || true
  ( converge_excluded ) || true
  return 0
}

# The device a sink belongs to. A Bluetooth device names its sink after a
# profile (bluez_output.<MAC>.1, .2 after a switch), and those are one device.
device_key() {
  local sink="$1"
  if [[ $sink == bluez_output.*.* ]]; then printf '%s\n' "${sink%.*}"; else printf '%s\n' "$sink"; fi
}

# The fields that make up a curve: what a device remembers.
jq_curve='{ mode, preset, graphic, parametric, preamp, headroom }'

# Each output device keeps its own curve. Leaving a device remembers the curve it
# was playing; arriving at one that has a curve brings it back; a device never
# seen before keeps what was playing, and remembers it from then on. That is
# what keeps an AutoEq correction for a pair of earbuds off the laptop speakers
# the moment the earbuds go back in their case -- and puts it back when they
# come out. device-memory off makes the curve one curve for every output again.
device_memory_pass() {
  local state target key active curve name
  state="$(state_read)"
  target="$(jq -r '.targetSink // ""' <<<"$state")"
  [[ -n $target ]] || return 0
  key="$(device_key "$target")"
  active="$(jq -r '.activeDevice // ""' <<<"$state")"
  [[ $key != "$active" ]] || return 0
  if [[ $(jq -r '.deviceMemory // "on"' <<<"$state") == off ]]; then
    state_write "$(jq -c --arg k "$key" '.activeDevice = $k' <<<"$state")"
    return 0
  fi
  if [[ -n $active ]]; then
    state="$(jq -c --arg a "$active" ".deviceCurves[\$a] = $jq_curve" <<<"$state")"
  fi
  state="$(jq -c --arg k "$key" '.activeDevice = $k' <<<"$state")"
  curve="$(jq -c --arg k "$key" '.deviceCurves[$k] // null' <<<"$state")"
  if [[ $curve == null ]]; then
    state_write "$state"
    return 0
  fi
  # The remembered curve is checked like any other before it is applied: an old
  # or hand-edited entry is dropped, not loaded.
  state="$(jq -c --argjson c "$curve" '. + ($c | with_entries(select(.value != null)))' <<<"$state")"
  state="$(cap_parametric_state "$state")"
  if [[ -n $(state_problem "$state") ]]; then
    echo "omarchy-equalizer: the curve remembered for $key is not valid; keeping the current one" >&2
    state_write "$(jq -c --arg k "$key" '.activeDevice = $k | del(.deviceCurves[$k])' <<<"$(state_read)")"
    return 0
  fi
  state="$(apply_headroom "$state")" || return 1
  state_write "$state"
  name="$(jq -r '.preset // "Custom"' <<<"$state")"
  echo "omarchy-equalizer: $target has its own curve; playing '$name'" >&2
  live_apply_active "" "$state"
}

# Keep the volume relief (see relief_db) in step with the volume. The follower
# calls this on every sink change -- the volume keys are one -- so it only writes
# when the relief actually moved. The fragment follows too: a restart has to
# come up with no more gain than the volume allows right now.
refresh_relief() {
  local state relief
  state="$(state_read)"
  relief="$(relief_db "$state")"
  [[ $(jq -n --argjson a "$relief" --argjson b "$(jq -r '.relief // 0' <<<"$state")" '(($a - $b) | fabs) < 0.05') == true ]] && return 0
  state="$(jq -c --argjson r "$relief" '.relief = $r' <<<"$state")"
  state_write "$state"
  sync_fragment "$state"
  ((graph_rebuilt)) || live_send_params "$(relief_params "$relief")" || true
}

# Long-running watcher (omarchy-equalizer-follow.service): retarget when the
# default sink changes, a sink appears/disappears, or a stream changes address.
# Drift (the one-shot aim of issue #2: the EQ stream can be relinked by
# WirePlumber a second after every move) is corrected by the same retarget pass;
# change events on the streams and sinks fuel that. Bursts are drained first.
follow_event_wanted() {
  case "$1" in
    *" on server"* | *"'new' on sink #"* | *"'remove' on sink #"* | \
    *"'change' on sink #"* | *"'change' on sink-input #"* | *"'new' on sink-input #"*) return 0 ;;
  esac
  return 1
}

cmd_follow() {
  need pactl
  local streak=0
  # systemd starts the follower with the unit, so the graph it just loaded is the
  # fragment on disk -- including after a restart systemd made on its own.
  note_running_layout
  locked_retarget() {
    take_lock
    cmd_retarget
    flock -u 9
  }
  follow_pass() {
    locked_retarget
    # A vanished target waits out its grace period; no event will announce the
    # end of it, so look again once it has run.
    if ((retarget_pending)); then
      sleep "${OMARCHY_EQ_VANISH_GRACE:-5}"
      locked_retarget
    fi
    # A move that does not stick (WirePlumber relinking it straight back) would
    # otherwise spin on its own change events: back off after a run of them.
    if ((converge_moved)); then
      streak=$((streak + 1))
      if ((streak >= 5)); then
        echo "omarchy-equalizer: the output stream keeps drifting; backing off" >&2
        sleep 2
        streak=0
      fi
    else
      streak=0
    fi
  }
  follow_pass
  pactl subscribe 2>/dev/null | while IFS= read -r line; do
    if follow_event_wanted "$line"; then
      while IFS= read -r -t 0.4 _; do :; done
      follow_pass
    fi
  done
}

cmd_set_gain() {
  local index="$1" gain="$2" state mode bands count
  state="$(state_read)"
  mode="$(jq -r '.mode' <<<"$state")"
  bands="$(active_bands "$state")"
  count="$(jq 'length' <<<"$bands")"
  [[ $index =~ ^(0|[1-9][0-9]{0,2})$ ]] || die "Band index must be a plain number."
  ((index < count)) || die "Band $index does not exist."
  need_number "$gain"

  state="$(jq -c --arg mode "$mode" --argjson i "$index" --argjson g "$gain" '
    .[$mode][$i].gain = $g' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"

  if sink_present; then live_apply_active "" "$state"; fi
}

# A yes/no from the command line, for a band's enabled flag.
parse_bool() {
  case "${1:-}" in
    true | on | yes | 1) printf 'true\n' ;;
    false | off | no | 0) printf 'false\n' ;;
    *) return 1 ;;
  esac
}

cmd_set_band() {
  local index="$1" key="$2" value="$3" state mode bands flag
  state="$(state_read)"
  mode="$(jq -r '.mode' <<<"$state")"
  bands="$(active_bands "$state")"
  [[ $index =~ ^(0|[1-9][0-9]{0,2})$ ]] || die "Band index must be a plain number."
  ((index < $(jq 'length' <<<"$bands"))) || die "Band $index does not exist."

  case "$key" in
    gain) need_number "$value"; state="$(jq -c --arg m "$mode" --argjson i "$index" --argjson v "$value" '.[$m][$i].gain = $v' <<<"$state")" ;;
    freq) need_number "$value"; state="$(jq -c --arg m "$mode" --argjson i "$index" --argjson v "$value" '.[$m][$i].freq = $v' <<<"$state")" ;;
    q)    need_number "$value"; state="$(jq -c --arg m "$mode" --argjson i "$index" --argjson v "$value" '.[$m][$i].q = $v' <<<"$state")" ;;
    type) state="$(jq -c --arg m "$mode" --argjson i "$index" --arg v "$value" '.[$m][$i].type = $v' <<<"$state")" ;;
    # A bypassed band stays in the list, keeps its slots and its values, and
    # shapes nothing until it is switched back on.
    enabled)
      flag="$(parse_bool "$value")" || die "Enabled must be on or off, not '$value'."
      state="$(jq -c --arg m "$mode" --argjson i "$index" --argjson v "$flag" '.[$m][$i].enabled = $v' <<<"$state")" ;;
    # 1..4 = 12..48 dB/octave, on a pass filter only (state_problem has the range
    # and the slot budget).
    slope)
      [[ $value =~ ^[1-4]$ ]] || die "Slope must be 1, 2, 3 or 4 (12 to 48 dB/octave), not '$value'."
      state="$(jq -c --arg m "$mode" --argjson i "$index" --argjson v "$value" '.[$m][$i].slope = $v' <<<"$state")" ;;
    label | name) ;;
    *) die "Unknown band property '$key'." ;;
  esac
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"

  # Every property is a value in the pool, so it lands live; the biquad chain
  # rebuilds only when its stage labels change (a type, a slope, a bypass).
  if sink_present; then live_apply_active "" "$state"; fi
}

cmd_add_band() {
  local state count slots
  state="$(state_read)"
  count="$(jq '.parametric | length' <<<"$state")"
  ((count < max_slots)) || die "Parametric mode holds at most 16 bands."
  slots="$(jq "$jq_slots"' [ .parametric[] | slots ] | add // 0' <<<"$state")"
  ((slots < max_slots)) || die "Parametric mode has no free filter slot: a steeper slope uses one slot per 12 dB/octave."
  state="$(jq -c '.mode = "parametric" | .parametric += [{ type: "peaking", freq: 1000, q: 1.0, gain: 0 }]' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"
  if sink_present; then live_apply_active "" "$state"; fi
}

cmd_remove_band() {
  local index="$1" state count
  state="$(state_read)"
  count="$(jq '.parametric | length' <<<"$state")"
  [[ $index =~ ^(0|[1-9][0-9]{0,2})$ ]] || die "Band index must be a plain number."
  ((index < count)) || die "Band $index does not exist."
  state="$(jq -c --argjson i "$index" 'del(.parametric[$i])' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"
  if sink_present; then live_apply_active "" "$state"; fi
}

cmd_set_mode() {
  local mode="$1" state
  need_mode "$mode"
  state="$(state_read)"
  state="$(jq -c --arg m "$mode" '.mode = $m' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"
  # In the pool the other set is only other values in the same slots; a biquad
  # chain of the other set's shape has to be built.
  if sink_present; then live_apply_active "" "$state"; fi
}

# A preset's name is a file name for the built-ins and a key for the rest, so it
# may not step out of either: no path separator, no leading dot, no control
# characters, and a sane length.
need_preset_name() {
  local name="${1:-}"
  [[ -n $name ]] || die "A preset needs a name."
  [[ ${#name} -le 64 ]] || die "A preset name is at most 64 characters."
  [[ $name != */* && $name != .* && ! $name =~ [[:cntrl:]] ]] ||
    die "A preset name may not contain '/', start with '.', or hold control characters."
}

cmd_apply_preset() {
  local name="$1" preset state mode from_bands to_bands from_preamp to_preamp from_layout relief
  need_preset_name "$name"
  preset="$(preset_read "$name")" || die "No preset named '$name'."

  # A preset may carry its own mode; a graphic preset applied while in
  # parametric mode switches modes rather than stuffing 10 bands into 8. A user
  # preset's mode is otherwise copied straight into the state, so validate it
  # before that write -- a bogus one must never be stored or reported.
  mode="$(jq -r '.mode // "graphic"' <<<"$preset")"
  need_mode "$mode"
  state="$(state_read)"
  # What is running right now: the ramp needs both ends, and the layout check
  # decides whether a live write is possible at all.
  from_bands="$(active_bands "$state")"
  from_preamp="$(jq -r '.preamp // 0' <<<"$state")"
  from_layout="$(running_layout)"

  state="$(jq -c --arg n "$name" --arg m "$mode" --argjson p "$preset" '
    .preset = $n | .mode = $m | .preamp = ($p.preamp // 0)
    | if ($p.graphic // null) != null and ($p.graphic | length) > 0 then .graphic = $p.graphic else . end
    | if ($p.parametric // null) != null and ($p.parametric | length) > 0 then .parametric = $p.parametric else . end
  ' <<<"$state")"
  # An old user preset may hold more bands than the pool has; cap it here so the
  # fragment, the live write and the headroom all see the same set.
  state="$(cap_parametric_state "$state")"
  state="$(apply_headroom "$state")" || exit 1
  to_bands="$(active_bands "$state")"
  to_preamp="$(jq -r '.preamp // 0' <<<"$state")"
  relief="$(jq -r '.relief // 0' <<<"$state")"
  state_write "$state"

  sink_present || return 0
  if [[ $(desired_layout "$state") != "$from_layout" ]]; then
    # Another shape: into or out of the pool, or a biquad chain of other
    # labels. Those nodes do not exist yet, or are wired in a different order.
    write_fragment "$state" "$(jq -r '.targetSink // ""' <<<"$state")"
    service_restart >/dev/null 2>&1
  elif running_pool; then
    # The pool already holds all 16 slots, so a preset is a values change and
    # lands live, without the ramp the biquad chain needs.
    sync_fragment "$state"
    live_apply_bands "$state" || service_restart >/dev/null 2>&1
  else
    # The same biquad labels: cross-fade in place instead of dropping audio
    # through a restart. Bands are interpolated by index, so the fade needs the
    # same band count too; the same labels from a different band split (one
    # band of slope 2 against two bands) is still one live write.
    sync_fragment "$state"
    if [[ $(jq 'length' <<<"$from_bands") -eq $(jq 'length' <<<"$to_bands") ]]; then
      live_ramp_bands "$from_bands" "$to_bands" "$from_preamp" "$to_preamp" "$relief" || service_restart >/dev/null 2>&1
    else
      live_apply_bands "$state" || service_restart >/dev/null 2>&1
    fi
  fi
}

cmd_save_preset() {
  local name="$1" state entry
  need_preset_name "$name"
  preset_is_builtin "$name" && die "'$name' is a built-in preset. Choose another name."
  state="$(state_read)"
  entry="$(jq -c '{ mode: .mode, graphic: .graphic, parametric: .parametric, preamp: (.preamp // 0) }' <<<"$state")"
  presets_ensure
  jq -c --arg n "$name" --argjson e "$entry" '.[$n] = $e' "$user_presets" >"$user_presets.tmp" &&
    mv "$user_presets.tmp" "$user_presets"
  state="$(jq -c --arg n "$name" '.preset = $n' <<<"$state")"
  state_write "$state"
}

cmd_delete_preset() {
  local name="$1"
  preset_is_builtin "$name" && die "'$name' is a built-in preset and cannot be deleted."
  [[ -n $name ]] || die "Name the preset to delete."
  presets_ensure
  jq -e --arg n "$name" 'has($n)' "$user_presets" >/dev/null 2>&1 || die "No user preset named '$name'."
  jq -c --arg n "$name" 'del(.[$n])' "$user_presets" >"$user_presets.tmp" &&
    mv "$user_presets.tmp" "$user_presets"
  # The bands stay as they are; only the label stops naming a preset that no
  # longer exists, otherwise the dropdown shows a ghost entry.
  local state
  state="$(state_read)"
  if [[ $(jq -r '.preset // ""' <<<"$state") == "$name" ]]; then
    state_write "$(jq -c '.preset = "Custom"' <<<"$state")"
  fi
}

# A preset as a file of its own, to keep or to hand to someone else. The format
# names itself and its version, so an importer can refuse what it cannot read.
cmd_export_preset() {
  local name="$1" out="${2:-}" doc
  need_preset_name "$name"
  doc="$(preset_read "$name")" || die "No preset named '$name'."
  doc="$(jq --arg n "$name" '{ format: "omarchy-equalizer-preset", version: 1, name: $n }
    + ({ description, mode, preamp, graphic, parametric } | with_entries(select(.value != null)))' <<<"$doc")"
  if [[ -n $out ]]; then
    printf '%s\n' "$doc" >"$out" || die "Could not write '$out'."
  else
    printf '%s\n' "$doc"
  fi
}

# A preset file from export-preset (anyone's), saved as a user preset. It is
# untrusted input like an AutoEq profile, and every field is checked before it
# is stored: the format, the name, the mode, and every band against the same
# ranges a state is held to.
cmd_import_preset() {
  local file="${1:-}" name="${2:-}" doc entry problem
  [[ -n $file && -f $file ]] || die "Give the preset file to import."
  doc="$(jq -c . "$file" 2>/dev/null)" || die "'$file' is not a preset file (it is not JSON)."
  [[ $(jq -r 'if type == "object" then .format // "" else "" end' <<<"$doc") == omarchy-equalizer-preset ]] ||
    die "'$file' is not an equalizer preset."
  [[ $(jq -r '.version // 0' <<<"$doc") == 1 ]] || die "'$file' is a preset format this version cannot read."
  [[ -n $name ]] || name="$(jq -r '.name // ""' <<<"$doc")"
  need_preset_name "$name"
  preset_is_builtin "$name" && die "'$name' is a built-in preset. Import it under another name: import-preset <file> <name>"
  need_mode "$(jq -r '.mode // "graphic"' <<<"$doc")"
  entry="$(jq -c '{ mode: (.mode // "graphic"), graphic: (.graphic // []), parametric: (.parametric // []), preamp: (.preamp // 0) }
    + (if (.description | type) == "string" then { description: .description[0:200] } else {} end)' <<<"$doc")"
  problem="$(state_problem "$entry")"
  [[ -z $problem ]] || die "The preset is out of range: $problem"
  need_numeric_bands_in "$entry"
  presets_ensure
  jq -c --arg n "$name" --argjson e "$entry" '.[$n] = $e' "$user_presets" >"$user_presets.tmp" &&
    mv "$user_presets.tmp" "$user_presets"
  jq -c -n --arg n "$name" '{ preset: $n }'
}

# Both band sets of a document, through the same number guard the graph writers
# use: an imported preset reaches the fragment as soon as it is applied.
need_numeric_bands_in() {
  local bands
  bands="$(jq -c '.graphic // []' <<<"$1")"; need_numeric_bands "$bands"
  bands="$(jq -c '.parametric // []' <<<"$1")"; need_numeric_bands "$bands"
}

cmd_reset() {
  local state mode from_bands to_bands from_preamp to_preamp relief
  state="$(state_read)"
  mode="$(jq -r '.mode' <<<"$state")"
  from_bands="$(active_bands "$state")"
  from_preamp="$(jq -r '.preamp // 0' <<<"$state")"
  # Reset means flat, so the preamp goes back to unity with the bands -- an
  # imported profile's cut left behind would quietly halve the output.
  state="$(jq -c --arg m "$mode" '
    .preset = "Flat" | .preamp = 0
    | if $m == "parametric" then
        .parametric = [ .parametric[] | .gain = 0 ]
      else
        .graphic = [ .graphic[] | .gain = 0 ]
      end' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  to_bands="$(active_bands "$state")"
  to_preamp="$(jq -r '.preamp // 0' <<<"$state")"
  relief="$(jq -r '.relief // 0' <<<"$state")"
  state_write "$state"
  if sink_present; then
    # Reset only flattens gains, so the running chain already has the right
    # shape: write it live rather than dropping audio through a restart. The
    # biquad chain gets the crossfade; the pool gets one whole-set write.
    if running_pool || ! layout_live "$state"; then
      live_apply_active "" "$state"
    else
      sync_fragment "$state"
      live_ramp_bands "$from_bands" "$to_bands" "$from_preamp" "$to_preamp" "$relief" || true
    fi
  fi
}

# ---------------------------------------------------------------- listening

# The A/B: the curve against Flat at the same loudness. Flat at unity is not a
# fair comparison -- a curve built from cuts plays quieter, one built from boosts
# louder, and the louder one always sounds better -- so Flat is played with the
# preamp that matches the curve's own level (curve_level_db, the same blend the
# built-in presets are level-matched on). The output stage stays as it is: this
# compares the bands, nothing else.
cmd_compare() {
  local value="${1:-toggle}" state on a b relief preamp
  state="$(state_read)"
  case "$value" in
    toggle) if [[ $(jq -r '.listen.mode // ""' <<<"$state") == flat ]]; then on=false; else on=true; fi ;;
    on) on=true ;;
    off) on=false ;;
    *) die "Compare must be on, off or toggle." ;;
  esac
  if $on; then
    relief="$(jq -r '.relief // 0' <<<"$state")"
    a="$(curve_level_db "$(active_bands "$state")" "$(jq -r '.preamp // 0' <<<"$state")")"
    state="$(jq -c '.listen = { mode: "flat" }' <<<"$state")"
    b="$(curve_level_db "$(listen_bands "$state")" 0)"
    preamp="$(LC_ALL=C awk -v a="$a" -v b="$b" 'BEGIN { p = a - b; if (p < -24) p = -24; if (p > 12) p = 12; printf "%.2f", p }')"
    state="$(jq -c --argjson p "$preamp" --argjson l "$a" '.listen.preamp = $p | .listen.levelDb = $l' <<<"$state")"
    printf 'Playing Flat at the curve'"'"'s loudness (%s dB against Flat at unity).\n' "$a"
  else
    state="$(jq -c 'del(.listen)' <<<"$state")"
    printf 'Playing the curve.\n'
  fi
  state_write "$state"
  if sink_present; then
    if layout_live "$state"; then live_apply_bands "$state" || true; else live_apply_active "" "$state"; fi
  fi
}

# One band alone, to hear what it does: every other band is out (Off in the
# pool; at zero gain on the biquad chain, where a pass filter has to stay). It
# plays with no more gain than either the curve's headroom or the band's own
# allows, so a lone boost cannot clip where the whole curve would not.
cmd_solo() {
  local value="${1:-}" state bands count preamp own
  state="$(state_read)"
  if [[ $value == off ]]; then
    state="$(jq -c 'del(.listen)' <<<"$state")"
    printf 'Playing every band.\n'
  else
    bands="$(active_bands "$state")"
    count="$(jq 'length' <<<"$bands")"
    [[ $value =~ ^(0|[1-9][0-9]{0,2})$ ]] || die "Solo takes a band index or off."
    ((value < count)) || die "Band $value does not exist."
    own="$(auto_preamp_db "$(jq -c --argjson i "$value" '[.[$i] + { enabled: true }]' <<<"$bands")")"
    preamp="$(jq -n --argjson a "$(jq -r '.preamp // 0' <<<"$state")" --argjson b "$own" '[$a, $b] | min')"
    state="$(jq -c --argjson i "$value" --argjson p "$preamp" '.listen = { mode: "solo", band: $i, preamp: $p }' <<<"$state")"
    printf 'Soloing band %s.\n' "$((value + 1))"
  fi
  state_write "$state"
  if sink_present; then
    if layout_live "$state"; then live_apply_bands "$state" || true; else live_apply_active "" "$state"; fi
  fi
}

# ---------------------------------------------------------------- preamp

# The preamp is one live control, so unlike a band's type it never needs a
# restart -- only the multiplier changes. Setting it by hand is also how the user
# takes over from automatic headroom, and the ceiling is what keeps that hand from
# stacking gain the limiter then has to remove from every sample: the stored value
# is clamped to the curve's own headroom (see apply_headroom) and the command says
# so on stderr instead of silently storing something else.
cmd_set_preamp() {
  local db="${1:-0}" state ceiling
  need_number "$db"
  state="$(state_read)"
  ceiling="$(preamp_ceiling_db "$(active_bands "$state")")"
  if [[ $(jq -n --argjson v "$db" --argjson c "$ceiling" '$v > $c') == true ]]; then
    clamp_warn "$db" "$ceiling"
    db="$ceiling"
  fi
  # Manual headroom takes no volume relief: the preamp is exactly what was set.
  state="$(jq -c --argjson v "$db" '.preamp = $v | .headroom = "manual" | .relief = 0 | del(.listen)' <<<"$state")"
  state_write "$state"
  # The preamp is live-only, so the fragment on disk would otherwise keep the
  # value from the last rebuild and a later restart would come up on a different
  # chain than the one that was tuned.
  sync_fragment "$state"
  if sink_present && ((!graph_rebuilt)); then live_apply_preamp "$state" || true; fi
}

# Switching back to auto recomputes the preamp from the bands and pushes the new
# multiplier live; manual only stores the label and enforces the ceiling, because
# the preamp does not move on its own.
cmd_set_headroom() {
  local value="${1:-}" state
  case "$value" in
    auto | manual) ;;
    *) die "Headroom must be auto or manual." ;;
  esac
  state="$(state_read)"
  state="$(jq -c --arg v "$value" '.headroom = $v' <<<"$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"
  sync_fragment "$state"
  if sink_present && ((!graph_rebuilt)); then live_apply_preamp "$state" || true; fi
}

# The preamp and the relief that goes with it, in one live write.
live_apply_preamp() {
  local state="$1"
  live_send_params "$(preamp_params "$(jq -r '.preamp // 0' <<<"$state")") $(relief_params "$(jq -r '.relief // 0' <<<"$state")")"
}

# ---------------------------------------------------------------- output stage commands

# The stage is toggled only through the plugins' controls, so none of these
# touches the graph's shape and none ever restarts a graph of the current layout.
# When LSP is missing the choice is still stored (so installing it later brings
# the stage up as the user left it) but there is nothing live to write; the
# warning is the only sign the stage is inactive.
lsp_inactive_warn() {
  printf 'LSP plugins are not installed; the output stage is inactive.\n' >&2
}

# Store one output-stage setting and send its controls live.
set_stage_value() { # key value params
  local key="$1" value="$2" params="$3" state
  state="$(state_read)"
  state="$(jq -c --arg k "$key" --arg v "$value" '.[$k] = $v' <<<"$state")"
  state_write "$state"
  # Like the preamp, the toggle is live-only: rewrite the fragment so a restart
  # does not resurrect the value from the last graph rebuild.
  sync_fragment "$state"
  if ! lsp_available; then
    lsp_inactive_warn
  elif sink_present && ((!graph_rebuilt)); then
    live_send_params "$params" || true
  fi
}

cmd_set_limiter() {
  local value="${1:-}"
  case "$value" in
    on | off) ;;
    *) die "Limiter must be on or off." ;;
  esac
  set_stage_value limiter "$value" "$(limiter_params "$value")"
}

cmd_set_boost() {
  local value="${1:-}"
  case "$value" in
    off | low | medium | high | night | voice) ;;
    *) die "Boost must be off, low, medium, high, night or voice." ;;
  esac
  set_stage_value boost "$value" "$(boost_params "$value")"
}

cmd_set_leveler() {
  local value="${1:-}"
  case "$value" in
    on | off) ;;
    *) die "Leveler must be on or off." ;;
  esac
  set_stage_value leveler "$value" "$(leveler_params "$value")"
}

# Channel handling is two builtin mixers, so unlike the output stage it works
# without LSP too.
set_channel_value() { # key json-value
  local state
  state="$(state_read)"
  state="$(jq -c --arg k "$1" --argjson v "$2" '.[$k] = $v' <<<"$state")"
  need_valid_state "$state"
  state_write "$state"
  sync_fragment "$state"
  if sink_present && ((!graph_rebuilt)); then live_send_params "$(mixer_params "$state")" || true; fi
}

cmd_set_channels() {
  case "${1:-}" in
    stereo | mono | swap) ;;
    *) die "Channels must be stereo, mono or swap." ;;
  esac
  set_channel_value channels "\"$1\""
}

cmd_set_balance() {
  local value="${1:-}"
  need_number "$value"
  [[ $(jq -n --argjson v "$value" '$v >= -1 and $v <= 1') == true ]] ||
    die "Balance runs from -1 (left) to 1 (right), not $value."
  set_channel_value balance "$value"
}

# ---------------------------------------------------------------- devices and apps

cmd_set_device_memory() {
  local value="${1:-}" state
  case "$value" in
    on | off) ;;
    *) die "Device memory must be on or off." ;;
  esac
  state="$(state_read)"
  state_write "$(jq -c --arg v "$value" '.deviceMemory = $v' <<<"$state")"
}

# The devices that remember a curve, and the preset each one plays.
cmd_devices() {
  state_read | jq -c '[ (.deviceCurves // {}) | to_entries[] | { device: .key, preset: (.value.preset // "Custom"), mode: (.value.mode // "graphic") } ]'
}

cmd_forget_device() {
  local key="${1:-}" state
  [[ -n $key ]] || die "Name the device to forget (see: devices)."
  state="$(state_read)"
  [[ $(jq -r --arg k "$key" '(.deviceCurves // {}) | has($k)' <<<"$state") == true ]] || die "No curve is remembered for '$key'."
  state_write "$(jq -c --arg k "$key" 'del(.deviceCurves[$k])' <<<"$state")"
}

cmd_exclude_app() {
  local name="${1:-}" state
  [[ -n $name && ${#name} -le 128 && ! $name =~ [[:cntrl:]] ]] || die "Name the app to keep off the equalizer."
  state="$(state_read)"
  state="$(jq -c --arg n "$name" '.excludedApps = ((.excludedApps // []) + [$n] | unique)' <<<"$state")"
  state_write "$state"
  if [[ $(jq -r '.enabled' <<<"$state") == true ]] && sink_present; then converge_excluded; fi
}

cmd_include_app() {
  local name="${1:-}" state target
  [[ -n $name ]] || die "Name the app to put back on the equalizer."
  state="$(state_read)"
  [[ $(jq -r --arg n "$name" '(.excludedApps // []) | map(ascii_downcase) | index($n | ascii_downcase) != null' <<<"$state") == true ]] ||
    die "'$name' is not excluded."
  state="$(jq -c --arg n "$name" '.excludedApps = [ (.excludedApps // [])[] | select(ascii_downcase != ($n | ascii_downcase)) ]' <<<"$state")"
  state_write "$state"
  # Its streams come back to the equalizer now, not at their next start.
  if [[ $(jq -r '.enabled' <<<"$state") == true ]] && sink_present; then
    local id sink app bin
    target="$(jq -r '.targetSink // ""' <<<"$state")"
    while IFS=$'\t' read -r id sink app bin; do
      [[ -n $id ]] || continue
      if [[ ${app,,} == "${name,,}" || ${bin,,} == "${name,,}" ]]; then
        pactl move-sink-input "$id" "$sink_name" >/dev/null 2>&1 || true
      fi
    done < <(app_stream_table)
  fi
}

# ---------------------------------------------------------------- AutoEq

# AutoEq publishes one ParametricEQ.txt per headphone measurement, plus a single
# INDEX.md listing all of them. Looking a headphone up by name therefore means
# fetching that one file; it changes slowly, so it is cached for a week.
autoeq_index="$state_root/autoeq-index.md"
autoeq_index_max_age=604800
autoeq_raw_base="https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results"

fetch_autoeq_index() {
  local age
  if [[ -s $autoeq_index ]]; then
    age=$(( $(date +%s) - $(stat -c %Y "$autoeq_index") ))
    (( age < autoeq_index_max_age )) && return 0
  fi
  state_dir_ensure
  need curl
  curl -fsSL -g --proto =https --proto-redir =https --max-filesize 5000000 --max-time 25 -o "$autoeq_index.tmp" \
    "$autoeq_raw_base/INDEX.md" >/dev/null 2>&1 || return 1
  mv "$autoeq_index.tmp" "$autoeq_index"
}

# Index lines look like: - [Sennheiser HD 650](./oratory1990/over-ear/Sennheiser%20HD%20650) by oratory1990
autoeq_search() {
  local query="$1" line name path
  fetch_autoeq_index || die "Could not fetch the AutoEq profile index (no network?)."
  [[ -n $query ]] || die "Give a headphone name to search for."

  : >"$state_root/autoeq-search.tmp"
  while IFS= read -r line; do
    # Parsed with shell expansions rather than a pattern, because headphone names
    # and profile paths both contain parentheses: a regex stopping at the first
    # ")" truncates "HIFIMAN Sundara (Dekoni sheepskin Earpads)" to a path that
    # does not exist. The line is "- [Name](./path) by source".
    [[ $line == "- ["* ]] || continue
    name="${line#*- [}"
    name="${name%%](*}"
    path_all="${line#*](./}"
    [[ $path_all != "$line" ]] || continue
    path="${path_all%% by *}"
    path="${path%)}"
    [[ -n $path ]] || continue
    jq -cn --arg n "$name" --arg p "$path" \
      --arg s "$(autoeq_name_from_path "${path%%/*}")" '{ name: $n, path: $p, source: $s }' \
      >>"$state_root/autoeq-search.tmp"
  done < <(grep -iF -- "$query" "$autoeq_index")

  jq -sc 'sort_by(.name, .source)' "$state_root/autoeq-search.tmp"
}

# A profile path's last segment is the profile directory, and its URL-decoded
# form is the headphone's name.
autoeq_name_from_path() {
  printf '%s' "$1" | awk -F/ '{print $NF}' | sed 's/%20/ /g; s/%2C/,/g; s/%28/(/g; s/%29/)/g; s/%26/\&/g; s/%27/'"'"'/g; s/%2B/+/g'
}

cmd_autoeq_search() {
  # --json is the panel's path: it needs the sources as data, not as a column.
  if [[ ${1:-} == "--json" ]]; then
    autoeq_search "${2:-}"
    return
  fi
  autoeq_search "$1" |
    jq -r '.[] | "\(.name)\t\(.source)"' |
    awk -F'\t' '{printf "%-46s %s\n", $1, $2}'
}

# AutoEq's type letters. Everything it emits is a peaking filter or one of the
# two shelves; the pass filters show up in hand-written EqualizerAPO configs.
autoeq_type() {
  case "$1" in
    PK) printf 'peaking' ;;
    LSC | LS) printf 'lowshelf' ;;
    HSC | HS) printf 'highshelf' ;;
    LP | LPQ) printf 'lowpass' ;;
    HP | HPQ) printf 'highpass' ;;
    BP) printf 'bandpass' ;;
    NO) printf 'notch' ;;
    AP) printf 'allpass' ;;
    *) printf 'peaking' ;;
  esac
}

# Parse one profile file into { preamp, bands }. The format is EqualizerAPO's:
#
#   Preamp: -6.1 dB
#   Filter 1: ON LSC Fc 105 Hz Gain 6.4 dB Q 0.70
#
# so this reads Peace and EqualizerAPO configs too. Off filters are skipped
# rather than imported as flat bands, which would silently widen the profile.
#
# A profile is untrusted input -- downloaded, or handed over as a local file --
# and every value in it is interpolated unquoted into the PipeWire fragment, so
# the numeric fields are checked here, before the profile is saved or applied:
# a JSON string survives --argjson and jq -r decodes its escapes, which would
# otherwise let a crafted profile close the control braces and write extra
# configuration into the graph (context.exec among it).
autoeq_profile_json() {
  local file="$1" type freq gain q bands='[]' preamp=0 problem
  while read -r type freq gain q; do
    [[ -z $type ]] && continue
    if [[ $type == PREAMP ]]; then
      is_number "$freq" || die "Profile preamp '$freq' is not a number."
      preamp="$freq"; continue
    fi
    is_number "$freq" || die "Profile Fc '$freq' is not a number."
    is_number "$gain" || die "Profile Gain '$gain' is not a number."
    is_number "$q" || die "Profile Q '$q' is not a number."
    bands="$(jq -c --arg t "$(autoeq_type "$type")" --argjson f "$freq" --argjson g "$gain" --argjson q "$q" \
      '. + [{ type: $t, freq: $f, gain: $g, q: $q }]' <<<"$bands")"
  done < <(LC_ALL=C awk '
    /^Preamp:/ { if (match($0, /-?[0-9]+(\.[0-9]+)?/)) preamp = substr($0, RSTART, RLENGTH) }
    /^Filter/ {
      # "Filter 1: ON PK ..." and the unnumbered "Filter: ON PK ...", both of
      # which EqualizerAPO and AutoEq write.
      if ($2 == "ON") t = $3; else if ($3 == "ON") t = $4; else next
      fc = ""; g = "0"; q = "0.7"
      for (i = 1; i <= NF; i++) {
        if ($i == "Fc") fc = $(i + 1)
        else if ($i == "Gain") g = $(i + 1)
        else if ($i == "Q") q = $(i + 1)
      }
      if (fc == "") next
      printf "%s %s %s %s\n", t, fc, g, q
    }
    END { printf "PREAMP %s\n", preamp + 0 }
  ' "$file")

  # Well-formed is not the same as safe: refuse a profile whose values are out of
  # range here, with the profile named, rather than at the state write.
  problem="$(state_problem "$(jq -c -n --argjson b "$bands" --argjson p "$preamp" \
    '{ preamp: $p, parametric: $b }')")"
  [[ -z $problem ]] || die "The profile is out of range: ${problem/ (parametric set)/}"

  jq -c -n --argjson b "$bands" --argjson p "$preamp" '{ preamp: $p, bands: $b }'
}

# A profile path comes from the downloaded index, so it is not trusted: "../"
# would leave the AutoEq tree for another repository on the same host, and
# brackets or braces are curl globs (one entry could fan out into thousands of
# requests). Index paths are plain "./source/type/Name" with %20 escapes.
need_autoeq_path() {
  case "$1" in
    *..* | *[\[\]\{\}\?\#]* | "") die "Refusing the AutoEq profile path '$1'." ;;
  esac
}

# Import by headphone name (downloaded), by an explicit index path, or from a
# local ParametricEQ.txt file.
cmd_import_autoeq() {
  local target="${1:-}" selected="${2:-}" name="" file parsed bands preamp state path url matches

  [[ -n $target ]] || die "Name a headphone, or give a path to a ParametricEQ.txt file."
  file="$(mktemp)"

  if [[ -f $target ]]; then
    cp "$target" "$file"
    name="$(basename "$target" .txt)"
    name="${name% ParametricEQ}"
  elif [[ -n $selected ]]; then
    # The panel offers the measurements it found and sends back the one that was
    # picked. Searching again here would re-rank by source and could download a
    # different measurement of the same headphone than the one chosen.
    need curl
    path="$selected"
    need_autoeq_path "$path"
    name="$(autoeq_name_from_path "$path")"
    url="$autoeq_raw_base/$path/$(basename "$path")%20ParametricEQ.txt"
    curl -fsSL -g --proto =https --proto-redir =https --max-filesize 5000000 --max-time 25 -o "$file" "$url" >/dev/null 2>&1 || {
      rm -f "$file"
      die "Could not download the profile for '$name'."
    }
  else
    need curl
    matches="$(autoeq_search "$target")"
    (( $(jq 'length' <<<"$matches") > 0 )) || {
      rm -f "$file"
      die "No AutoEq profile matched '$target'. Try: omarchy-equalizer autoeq-search <name>"
    }
    # Pick between sources deterministically: an exact name match first (so
    # searching "HIFIMAN Sundara" does not land on the Dekoni-earpad variant),
    # then oratory1990 -- the source the project's own guides point at -- and
    # finally the shortest name, which is the least qualified variant.
    path="$(jq -r --arg q "$target" '
      (map(select((.name | ascii_downcase) == ($q | ascii_downcase)))) as $exact
      | (if ($exact | length) > 0 then $exact else . end)
      | sort_by((if .source == "oratory1990" then 0 else 1 end), (.name | length))
      | .[0].path' <<<"$matches")"
    need_autoeq_path "$path"
    name="$(autoeq_name_from_path "$path")"
    url="$autoeq_raw_base/$path/$(basename "$path")%20ParametricEQ.txt"
    curl -fsSL -g --proto =https --proto-redir =https --max-filesize 5000000 --max-time 25 -o "$file" "$url" >/dev/null 2>&1 || {
      rm -f "$file"
      die "Could not download the profile for '$name'."
    }
  fi

  # The parser runs in a command substitution, so its die (exit) only leaves the
  # subshell: propagate the failure rather than importing half a profile.
  parsed="$(autoeq_profile_json "$file")" || exit 1
  rm -f "$file"
  bands="$(jq -c '.bands' <<<"$parsed")"
  preamp="$(jq -r '.preamp' <<<"$parsed")"
  (( $(jq 'length' <<<"$bands") > 0 )) || die "The profile has no usable filters."

  state="$(state_read)"
  state="$(jq -c --argjson b "$bands" --argjson p "$preamp" \
    '.mode = "parametric" | .parametric = $b | .preamp = $p' <<<"$state")"
  # A profile with more filters than the pool has is capped the same way a
  # hand-edited state is, so the imported bands and the applied graph agree.
  state="$(cap_parametric_state "$state")"
  state="$(apply_headroom "$state")" || exit 1
  state_write "$state"

  # An imported profile is kept as a preset: it has to survive the next import.
  # A profile named like a built-in ("Rock" is a headphone too) is saved under a
  # suffix rather than failing to save and leaving the built-in's label over the
  # imported bands.
  if preset_is_builtin "$name"; then name="$name (AutoEq)"; fi
  cmd_save_preset "$name" >/dev/null 2>&1 || true

  # A profile into the pool is a values write; into a biquad chain it is a new
  # chain of other labels, which the layout check rebuilds.
  if sink_present; then live_apply_active "" "$state"; fi

  jq -c -n --arg n "$name" --argjson p "$preamp" --argjson c "$(jq 'length' <<<"$bands")" \
    '{ preset: $n, preamp: $p, bands: $c }'
}

# One JSON document for the panel: what is on, what the bands are, what presets
# exist. The panel never reads the state file itself.
cmd_status() {
  local state bands preset_name preset_doc
  state="$(state_read)"
  bands="$(active_bands "$state")"
  # The preset the state names may no longer resolve ("Custom", or a user preset
  # whose file was deleted). One read for the whole document, not one per band;
  # a missing one becomes null and the jq below reports "not edited" instead of
  # failing or treating the absence as a difference.
  preset_name="$(jq -r '.preset // "Flat"' <<<"$state")"
  preset_doc="$(preset_read "$preset_name" 2>/dev/null)" || preset_doc='null'
  jq -c -n --argjson s "$state" --argjson b "$bands" --argjson p "$(preset_list_json)" \
     --argjson d "$preset_doc" \
     --argjson r "$(graph_rate)" --argjson ap "$(auto_preamp_db "$bands")" \
     --argjson oa "$(lsp_available && echo true || echo false)" \
     --argjson maxslots "$max_slots" --argjson v "$state_version" "$jq_slots"'
    # A band written with its defaults spelled out (enabled true, slope 1) is the
    # same band as one without them, so neither can make a preset read as edited.
    def norm: map(with_entries(select((.key != "enabled" or .value == false) and (.key != "slope" or .value != 1))));
    ($d // {}) as $preset
    | ($s.mode // "graphic") as $mode
    # Only an array this preset actually defines for the active mode can be
    # compared. A graphic-only preset viewed in parametric mode says nothing
    # about parametric, so it must not read as edited.
    | (if ($preset | type) == "object" and ($preset | has($mode))
            and (($preset[$mode] | type) == "array")
            and (($preset[$mode] | length) > 0)
       then $preset[$mode] else null end) as $presetBands
    | {
      version: $v,
      sampleRate: $r,
      enabled: ($s.enabled // false),
      mode: ($s.mode // "graphic"),
      preset: ($s.preset // "Flat"),
      headroom: ($s.headroom // "auto"),
      # The preamp is the full-volume headroom cut; the relief is how much of it
      # the volume gives back right now, so appliedPreamp is what the bands are
      # actually played under.
      preamp: ($s.preamp // 0),
      relief: ($s.relief // 0),
      appliedPreamp: ((($s.preamp // 0) + ($s.relief // 0)) * 10 | round / 10),
      autoPreamp: $ap,
      # The most gain manual headroom may hold for these bands. Same number as
      # autoPreamp by construction (preamp_ceiling_db is auto_preamp_db), named
      # separately because the panel uses it as the upper bound of the slider.
      preampCeiling: $ap,
      limiter: ($s.limiter // "on"),
      boost: ($s.boost // "off"),
      leveler: ($s.leveler // "off"),
      channels: ($s.channels // "stereo"),
      balance: ($s.balance // 0),
      outputStage: $oa,
      sinkPresent: false,
      targetSink: ($s.targetSink // ""),
      bands: $b,
      # The A/B or solo in force, if any.
      listen: ($s.listen // null),
      # Whether the loaded preset still matches the running band set. Value
      # equality on the parsed arrays, so formatting and the preset order or
      # description can never make a match look edited.
      presetDirty: ($presetBands != null and ($b | norm) != ($presetBands | norm)),
      graphicCount: ($s.graphic | length),
      parametricCount: ($s.parametric | length),
      slots: ([ $b[] | select(type == "object") | slots ] | add // 0),
      maxSlots: $maxslots,
      deviceMemory: ($s.deviceMemory // "on"),
      activeDevice: ($s.activeDevice // ""),
      devices: [ ($s.deviceCurves // {}) | to_entries[] | { device: .key, preset: (.value.preset // "Custom") } ],
      excludedApps: ($s.excludedApps // []),
      presets: $p
    }'
}

# A sink's human name, as pactl reports it ("Sony WF-1000XM6"), or nothing.
sink_description() {
  [[ -n ${1:-} ]] || return 0
  pactl list sinks 2>/dev/null | awk -v want="$1" '
    /^[[:space:]]*Name: / { name = $2 }
    /^[[:space:]]*Description: / && name == want { sub(/^[[:space:]]*Description: /, ""); print; exit }'
}

# The app streams playing right now, for the panel's exclusion list: name, binary,
# whether it is excluded and whether it is on the equalizer.
apps_json() {
  local excluded="$1" index
  index="$(sink_index "$sink_name")"
  app_stream_table | jq -R -s -c --argjson x "$excluded" --arg eq "${index:-}" '
    ($x | map(ascii_downcase)) as $l
    | [ split("\n")[] | select(length > 0) | split("\t")
        | { id: (.[0] | tonumber? // 0), name: (.[2] // ""), binary: (.[3] // ""), onEq: ((.[1] // "") == $eq) }
        | . as $a
        | .excluded = ((($l | index($a.name | ascii_downcase)) != null)
                       or ($a.binary != "" and ($l | index($a.binary | ascii_downcase)) != null)) ]
    | unique_by(.name)'
}

cmd_status_full() {
  local out target vol
  out="$(cmd_status)"
  target="$(jq -r '.targetSink // ""' <<<"$out")"
  vol="$(sink_volume_db)"
  jq -c --argjson present "$(sink_present && echo true || echo false)" \
     --arg default "$(current_default_sink)" \
     --arg physical "$(physical_output)" \
     --arg key "$( [[ -n $target ]] && device_key "$target")" \
     --arg label "$(sink_description "$target")" \
     --arg vol "$vol" \
     --argjson apps "$(apps_json "$(jq -c '.excludedApps' <<<"$out")")" \
    '.sinkPresent = $present | .defaultSink = $default | .physicalSink = $physical
     | .deviceKey = $key | .deviceLabel = $label | .apps = $apps
     | .volumeDb = (($vol | tonumber? | . * 100 | round / 100) // null)' <<<"$out"
}

cmd_toggle() {
  local state
  state="$(state_read)"
  if [[ $(jq -r '.enabled' <<<"$state") == true ]] && sink_present; then
    cmd_disable
  else
    cmd_enable
  fi
}

usage() {
  cat <<'EOF'
Usage: omarchy-equalizer <command> [args]

  status                          JSON state for the shell plugin
  enable | disable | toggle       Switch the equalizer on or off
  retarget                        Re-aim the EQ at the current output device
  follow                          Watch for output changes (run by systemd)
  set-mode <graphic|parametric>   Choose which band set is processed
  set-gain <index> <dB>           Set one band's gain (live, no restart)
  set-band <index> <gain|freq|q|type|enabled|slope> <value>
                                  Set one band property; enabled on|off bypasses
                                  a band, slope 1-4 is 12-48 dB/oct (pass filters)
  add-band                        Append a parametric band (16 filter slots)
  remove-band <index>             Drop a parametric band
  compare [on|off|toggle]         A/B: hear Flat at the curve's own loudness
  solo <index|off>                Hear one band alone
  apply-preset <name>             Load a preset
  save-preset <name>              Save the current bands as a preset
  delete-preset <name>            Delete a user preset
  export-preset <name> [file]     Write a preset to a file (or stdout)
  import-preset <file> [name]     Save a preset file as a user preset
  reset                           Flatten the current mode's gains
  presets                         List preset names
  set-preamp <dB>                 Whole-chain preamp (live, no restart)
  set-headroom <auto|manual>      Auto-track the preamp to the band peaks
  set-limiter <on|off>            Brickwall output limiter (live, no restart)
  set-boost <off|low|medium|high|night|voice>
                                  Dynamics: boost strength, or a night/voice character
  set-leveler <on|off>            Bring every source to one loudness
  set-channels <stereo|mono|swap> Channel handling ahead of the bands
  set-balance <-1..1>             Left/right balance
  set-device-memory <on|off>      Give every output device its own curve
  devices                         Devices that remember a curve
  forget-device <device>          Drop a device's remembered curve
  exclude-app <name>              Keep an app off the equalizer
  include-app <name>              Put an excluded app back on it
  excluded-apps                   List the excluded apps
  autoeq-search [--json] <name>   Search AutoEq headphone profiles
  import-autoeq <name|file> [index-path]
                                  Import an AutoEq profile, saved as a preset
EOF
}

command="${1:-status}"
shift 2>/dev/null || true

# One command changes the state at a time. Each one reads, edits and writes the
# whole state, and the follower and the panel do run at once -- without this, ten
# quick gain changes kept one. The follower takes the lock per pass instead (it
# never exits), which also keeps it from acting halfway through a restart.
take_lock() {
  state_dir_ensure
  exec 9>"$state_root/.lock"
  flock -w 30 9 || die "Another equalizer command is still running."
}
case "$command" in
  status | follow | presets | autoeq-search | devices | excluded-apps | export-preset | help | --help | -h | "") ;;
  *) take_lock ;;
esac

case "$command" in
  status) cmd_status_full ;;
  enable) cmd_enable ;;
  disable) cmd_disable ;;
  toggle) cmd_toggle ;;
  retarget) cmd_retarget ;;
  follow) cmd_follow ;;
  set-mode) cmd_set_mode "${1:-}" ;;
  set-gain) cmd_set_gain "${1:-0}" "${2:-0}" ;;
  set-band) cmd_set_band "${1:-0}" "${2:-}" "${3:-0}" ;;
  add-band) cmd_add_band ;;
  remove-band) cmd_remove_band "${1:-0}" ;;
  apply-preset) cmd_apply_preset "${1:-}" ;;
  save-preset) cmd_save_preset "${1:-}" ;;
  delete-preset) cmd_delete_preset "${1:-}" ;;
  reset) cmd_reset ;;
  set-preamp) cmd_set_preamp "${1:-0}" ;;
  set-headroom) cmd_set_headroom "${1:-}" ;;
  set-limiter) cmd_set_limiter "${1:-}" ;;
  set-boost | set-dynamics) cmd_set_boost "${1:-}" ;;
  set-leveler) cmd_set_leveler "${1:-}" ;;
  set-channels) cmd_set_channels "${1:-}" ;;
  set-balance) cmd_set_balance "${1:-}" ;;
  compare) cmd_compare "${1:-toggle}" ;;
  solo) cmd_solo "${1:-}" ;;
  set-device-memory) cmd_set_device_memory "${1:-}" ;;
  devices) cmd_devices ;;
  forget-device) cmd_forget_device "${1:-}" ;;
  exclude-app) cmd_exclude_app "${1:-}" ;;
  include-app) cmd_include_app "${1:-}" ;;
  excluded-apps) state_read | jq -r '.excludedApps // [] | .[]' ;;
  export-preset) cmd_export_preset "${1:-}" "${2:-}" ;;
  import-preset) cmd_import_preset "${1:-}" "${2:-}" ;;
  autoeq-search) cmd_autoeq_search "${1:-}" "${2:-}" ;;
  import-autoeq) cmd_import_autoeq "${1:-}" "${2:-}" ;;
  presets) preset_list_json | jq -r '.[].name' ;;
  help | --help | -h) usage ;;
  *) usage >&2; exit 1 ;;
esac